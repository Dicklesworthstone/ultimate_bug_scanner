        ".eslintrc",
        ".eslintrc.*",
        "eslint.config.*",
        ".babelrc",
        "babel.config.*",
        ".env",
        ".env.*"
      ],
      "contract": 1,
      "extra_flags": [
        "--dump-rules",
        "--list-rules",
        "--max-samples",
        "--report-json",
        "--rules"
      ]
    },
    "python": {
