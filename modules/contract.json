{
  "contract_version": 1,
  "about": "Machine-readable contract of the language modules (bead A3b, 2026-09-03). Hand-maintained; scripts/check_docs_claims.py verifies every flag here against each module's argument parser, renders modules/README.md's Options block from it (scripts/gen_module_readme.py) and fails when a parser flag shared by 7+ modules is missing here. Per-module `contract` becomes 2 once the A4 port (modules/lib/ubs-common.sh + ubs_core, --files-from) lands.",
  "invocation": "modules/ubs-<lang>.sh [PROJECT_DIR|FILE] [options] [OUTPUT_FILE]",
  "formats": {
    "module": [
      "text",
      "json",
      "sarif"
    ],
    "meta_runner_only": [
      "jsonl",
      "toon"
    ],
    "note": "A module asked for --format=jsonl or --format=toon exits 2 (ubs_validate_format in modules/lib/ubs-common.sh); the meta-runner derives those from the module's json."
  },
  "exit_codes": {
    "0": "no critical findings (and no warnings when --fail-on-warning is set)",
    "1": "critical findings, or warnings with --fail-on-warning",
    "2": "usage or environment error: unknown flag, unsupported --format, missing modules/lib/ubs-common.sh, missing required tool"
  },
  "environment": {
    "UBS_LANG": "set by the meta-runner to the module's language name",
    "UBS_METRICS_DIR": "directory where helpers drop metrics JSON the meta-runner attaches to the summary",
    "UBS_SKIP_TYPE_NARROWING": "1 skips the type-narrowing helpers (also --skip-type-narrowing on ubs)",
    "UBS_AST_GREP_BIN": "explicit ast-grep binary (the meta-runner exports the verified one)",
    "UBS_MODULE_LIB_DIR": "set by the module itself: directory holding lib/ubs-common.sh next to the module",
    "NO_COLOR": "disable ANSI colour (same as --no-color)"
  },
  "summary_json_keys": [
    "language",
    "project",
    "files",
    "critical",
    "warning",
    "info",
    "timestamp",
    "status",
    "findings",
    "categories",
    "ast_grep_rules",
    "extras",
    "uv_tools"
  ],
  "findings_schema": "ubs --schema=json (scanners[].findings[] with title/severity/count/samples[file,line,code]); per-finding records via --report-json (js, python) or --emit-findings-json (csharp) until bead K2",
  "rule_id_grammar": "<lang>.<family>.<name> (e.g. js.async.dangling-promise, py.json.loads-no-try); category ids are <lang>.<slug> (e.g. js.debug, python.security)",
  "flags": [
    {
      "flag": "--format",
      "value": "FMT",
      "modules": "all",
      "documented": true,
      "doc": "text|json|sarif (default: text). jsonl and toon are produced by the\nmeta-runner from the module's json output, not by the module itself"
    },
    {
      "flag": "--ci",
      "modules": "all",
      "documented": true,
      "doc": "stable timestamps (UTC ISO8601)"
    },
    {
      "flag": "--fail-on-warning",
      "modules": "all",
      "documented": true,
      "doc": "exit non-zero if any warnings or critical"
    },
    {
      "flag": "--verbose",
      "short": "-v",
      "modules": "all",
      "documented": true,
      "doc": "print more samples in text mode"
    },
    {
      "flag": "--quiet",
      "short": "-q",
      "modules": "all",
      "documented": false,
      "doc": "print only the summary"
    },
    {
      "flag": "--no-color",
      "modules": "all",
      "documented": false,
      "doc": "disable ANSI colour"
    },
    {
      "flag": "--jobs",
      "value": "N",
      "modules": "all",
      "documented": true,
      "doc": "parallel hint (propagated to ripgrep/child tools)"
    },
    {
      "flag": "--exclude",
      "value": "GLOBS",
      "modules": "all",
      "documented": true,
      "doc": "additional path globs to skip (forwarded by the meta-runner)"
    },
    {
      "flag": "--include-ext",
      "value": "CSV",
      "modules": "all",
      "documented": true,
      "doc": "extra file extensions to scan"
    },
    {
      "flag": "--skip",
      "value": "CSV",
      "modules": "all",
      "documented": true,
      "doc": "skip category numbers (numbers differ per module)"
    },
    {
      "flag": "--only",
      "value": "CSV",
      "modules": [
        "cpp",
        "csharp",
        "elixir",
        "java",
        "ruby",
        "rust",
        "swift"
      ],
      "documented": false,
      "doc": "run only these category numbers"
    },
    {
      "flag": "--rules",
      "value": "DIR",
      "modules": [
        "cpp",
        "csharp",
        "golang",
        "java",
        "js",
        "python",
        "ruby",
        "rust",
        "swift"
      ],
      "documented": true,
      "doc": "merge custom ast-grep rules into the built-in pack (all modules except elixir)"
    },
    {
      "flag": "--list-rules",
      "modules": [
        "csharp",
        "golang",
        "java",
        "js",
        "ruby",
        "rust",
        "swift"
      ],
      "documented": true,
      "doc": "print generated ast-grep rule ids and exit (js, golang, rust, java, ruby, swift, csharp)"
    },
    {
      "flag": "--dump-rules",
      "value": "DIR",
      "modules": [
        "csharp",
        "golang",
        "java",
        "js",
        "ruby",
        "rust",
        "swift"
      ],
      "documented": true,
      "doc": "write the generated ast-grep rules to DIR (same modules as --list-rules)"
    },
    {
      "flag": "--list-categories",
      "modules": [
        "cpp",
        "csharp",
        "python",
        "rust",
        "swift"
      ],
      "documented": true,
      "doc": "print the category table and exit (python, rust, cpp, swift, csharp)"
    },
    {
      "flag": "--help",
      "short": "-h",
      "modules": "all",
      "documented": true,
      "doc": "this help"
    }
  ],
  "modules": {
    "js": {
      "file": "ubs-js.sh",
      "display": "JavaScript / TypeScript",
      "extensions": [
        "js",
        "jsx",
        "ts",
