 diff --git a/ubs b/ubs
index 0a3045e..a36ffb8 100755
--- a/ubs
+++ b/ubs
@@ -29,6 +29,60 @@ shopt -s lastpipe || true
 trap '' SIGPIPE 2>/dev/null || true
 
 UBS_VERSION="5.4.16"
+# The optional service is a release executable, not a command trusted via PATH.
+# scripts/update_checksums.py keeps this pin in sync with ubs-daemon.
+UBS_DAEMON_SHA256="c595bca81ae6a7570262c5d596fcac91dc89ac89ef6e9330c31f77232bde776b"
+
+# Route service commands before scan setup, dependency probes or self-updates.
+# Execute the exact bytes checked below, not a path that can change after hashing.
+case "${1:-}" in
+  serve|--client|daemon)
+    _service_command="$1"; shift
+    case "$_service_command" in
+      serve) set -- serve "$@" ;;
+      --client) set -- client "$@" ;;
+    esac
+    _service_python="${UBS_PYTHON:-python3}"
+    if ! command -v "$_service_python" >/dev/null 2>&1; then
+      echo 'ERROR: The local scan service requires Python >= 3.9; set UBS_PYTHON.' >&2
+      exit 2
+    fi
+    exec "$_service_python" -I -S - "${BASH_SOURCE[0]}" "$UBS_DAEMON_SHA256" "$@" <<'PYDAEMON'
+import hashlib
+import os
+from pathlib import Path
+import stat
+import sys
+
+try:
+    if os.name != 'posix' or sys.version_info < (3, 9):
+        raise ValueError('The local scan service requires POSIX and Python >= 3.9')
+    runner = Path(sys.argv[1]).resolve(strict=True)
+    expected = sys.argv[2]
+    frontend = runner.with_name('ubs-daemon')
+    if frontend.is_symlink():
+        raise ValueError('Refusing a symlinked ubs-daemon')
+    descriptor = os.open(frontend, os.O_RDONLY | os.O_NONBLOCK | getattr(os, 'O_NOFOLLOW', 0))
+    with os.fdopen(descriptor, 'rb') as stream:
+        info = os.fstat(stream.fileno())
+        if not stat.S_ISREG(info.st_mode) or info.st_size > 512 * 1024:
+            raise ValueError('ubs-daemon must be a regular file smaller than 512 KiB')
+        source = stream.read(512 * 1024 + 1)
+    if len(source) > 512 * 1024 or hashlib.sha256(source).hexdigest() != expected:
+        raise ValueError('ubs-daemon checksum mismatch; reinstall the matching release')
+except (OSError, ValueError) as exc:
+    print(f'ubs: cannot load the verified local scan service: {exc}', file=sys.stderr)
+    raise SystemExit(2)
+
+# -I -S prevents project/PYTHONPATH/site startup code from running before the
+# checksum check. The service itself uses only the standard library.
+sys.argv = [str(frontend), *sys.argv[3:]]
+exec(compile(source, str(frontend), 'exec'),
+     {'__name__': '__main__', '__file__': str(frontend), '__package__': None})
+PYDAEMON
+    ;;
+esac
+
 # Module / helper fetches must be checksum-stable for an installed
 # release, so they pin to the tagged tree matching this script's
 # UBS_VERSION. main is reserved for the self-update probe below
