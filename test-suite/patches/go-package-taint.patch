+    variadic = min(variadics) if variadics else None
+
+    def widen(fact):
+        if variadic is None:
+            return fact
+        return frozenset(_Trace(trace.source,
+                                min(trace.parameter, variadic) if trace.parameter is not None else None,
+                                trace.path) for trace in fact)
