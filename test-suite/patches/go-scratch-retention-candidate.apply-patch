     scan_errors: list[str] = []
+    if args.lifecycle_refused:
+        # The legacy lifecycle helper uses `go run`, whose compiler manages
+        # temporary files independently of scanner retention. The module
+        # explicitly signals this unavailable phase; direct static-core callers
+        # do not request the shell module's compiled bridge. Report the
+        # unperformed layer in every format, including warm-cache scans.
+        scan_errors.append(
+            "Go lifecycle helper refused: UBS_KEEP_TEMP=1 cannot retain compiler scratch; "
+            "select --skip=17 for static checks without the compiled helper"
+        )
