+        self.scan_sort('function order(items){return items.sort();} '
+                       'const dirty=["zz-clean",req.query.html]; const clean=["b","a"]; '
+                       'order(dirty); order(clean); res.send(dirty[0]); res.send(clean[0]);', 'xss')
