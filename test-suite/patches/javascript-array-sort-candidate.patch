+                  'const box={items:["zz-clean",req.query.html]};\n'
+                  'const alias=order(box.items);\n'
+                  'res.send(box.items[0]);\nres.send(alias[0]);')
+        found = self.scan_sort(source, 'xss', 'xss')
+        self.assertEqual([row['line'] for row in found], [4, 5])
