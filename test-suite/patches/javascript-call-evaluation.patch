+        for operator in ('||=', '&&=', '??='):
+            with self.subTest(operator=operator):
+                self.check(prefix + f'value {operator} clear(); res.send(out);', 'xss')
+                self.check(prefix + f'res.send(value {operator} clear()); res.send(out);', 'xss')
+
 
