+    def test_unawaited_rejection_does_not_stop_the_caller(self):
+        self.check('async function fail() { throw Error(); } fail(); res.send(req.query.html);', 'xss')
+        self.check('const fail = async () => { throw Error(); }; fail(); res.send(req.query.html);', 'xss')
+        self.check('const fail = async () => { throw Error(); }; fail(); res.send("safe");')
+        self.check('async\nfunction fail() { throw Error(); } fail(); res.send(req.query.html);')
+
+    def test_awaited_rejection_reaches_handler_not_normal_continuation(self):
+        self.check('async function fail() { throw Error(); } await fail(); res.send(req.query.html);')
+        self.check('let out = "safe"; async function fail() { out = req.query.html; throw Error(); } '
+                   'try { await (fail()); } catch (error) { res.send(out); }', 'xss')
+
+    def test_async_cleanup_without_await_cannot_strongly_clear_taint(self):
+        prefix = 'let out = req.query.html; async function clear() { await external(); out = "safe"; } '
+        self.check(prefix + 'clear(); res.send(out);', 'xss')
+        self.check(prefix + 'await clear(); res.send(out);')
+
+    def test_async_default_rejection_does_not_run_body_or_stop_caller(self):
+        prefix = ('let out = "safe"; function fail() { out = req.query.html; throw Error(); } '
+                  'async function accept(v = fail()) { out = "body"; } ')
+        self.check(prefix + 'accept(); res.send(out);', 'xss')
+        self.check(prefix + 'await accept(); res.send(out);')
+        self.check(prefix + 'accept("explicit"); res.send(out);')
+
+    def test_rejected_promise_argument_does_not_prevent_sink_call(self):
+        self.check('async function fail() { throw Error(); } res.send(req.query.html, fail());', 'xss')
+        self.check('async function fail() { throw Error(); } res.send(req.query.html, await fail());')
+
+    def test_generator_creation_does_not_run_body_cleanup(self):
+        for kind in ('function*', 'async function*'):
+            with self.subTest(kind=kind):
+                self.check(f'let out = req.query.html; {kind} clear() {{ out = "safe"; yield 1; }} '
+                           'clear(); res.send(out);', 'xss')
+
+    def test_spread_literal_elements_execute_once(self):
+        prefix = ('let a = req.query.html, b = "safe"; function swap() { const tmp = a; a = b; b = tmp; return a; } '
+                  'function first(value) { return value; } ')
+        self.check(prefix + 'res.send(first(...[swap()]));')
+        self.check(prefix + 'res.send(first(...[swap()])); res.send(b);', 'xss')
+        self.check(prefix + 'res.send(first(...[swap(), swap()]));')
+
+    def test_nested_spreads_keep_evaluation_order(self):
+        prefix = ('let out = req.query.html; function clear() { out = "safe"; return ""; } '
+                  'function first(a, b) { return a; } function second(a, b) { return b; } ')
+        self.check(prefix + 'res.send(first(...[...[out, clear()]]));', 'xss')
+        self.check(prefix + 'res.send(second(...[...[clear(), out]]));')
+
+    def test_unknown_spread_expression_is_not_reexecuted(self):
+        prefix = ('let a = req.query.html, b = "safe"; function swap() { const tmp = a; a = b; b = tmp; return a; } '
+                  'function accept(...values) { return "safe"; } ')
+        self.check(prefix + 'accept(...swap()); res.send(a);')
+        self.check(prefix + 'accept(...swap()); res.send(b);', 'xss')
+
+    def test_spread_sql_parameters_are_not_query_text(self):
+        self.check('db.query(...["SELECT * FROM users WHERE id = ?", req.query.id]);')
+        self.check('db.query(...[req.query.sql, []]);', 'sql')
+        self.check('eval(...[req.query.code]);', 'eval')
+        self.check('db.query(...values, req.query.sql);', 'sql')
+        self.check('db.query("SELECT 1", ...values, req.query.id);')
+
+    def test_unknown_spread_keeps_normal_path_around_throwing_default(self):
+        prefix = 'function fail() { throw Error(); } function get(value = fail()) { return req.query.html; } '
+        self.check(prefix + 'res.send(get(...values));', 'xss')
+        self.check(prefix + 'res.send(get());')
+        self.check(prefix + 'res.send(get(...[]));')
+
+    def test_spread_holes_and_trailing_commas_bind_defaults(self):
+        prefix = 'function second(a, b = req.query.html) { return b; } '
+        self.check(prefix + 'res.send(second(...["safe", ,]));', 'xss')
+        self.check(prefix + 'res.send(second(...["safe", "safe",]));')
+
+    def test_dom_assignment_value_is_evaluated_once(self):
+        prefix = 'let out = req.query.html; function clear() { out = "safe"; return ""; } '
+        for member in ('innerHTML', 'outerHTML'):
+            with self.subTest(member=member):
+                self.check(prefix + f'document.getElementById("target").{member} = out + clear();', 'xss')
+                self.check(prefix + f'document.getElementById("target").{member} = clear() + out;')
+
+    def test_dom_receiver_executes_before_assigned_value(self):
+        self.check('let out = req.query.html; function target() { out = "safe"; return node; } target().innerHTML = out;')
+        self.check('let out = "safe"; function target() { out = req.query.html; return node; } target().innerHTML = out;', 'xss')
+
+    def test_dom_assignment_does_not_apply_rhs_write_twice(self):
+        prefix = 'let a = req.query.html, b = "safe"; function swap() { const tmp = a; a = b; b = tmp; return a; } '
+        self.check(prefix + 'document.getElementById("target").innerHTML = swap(); res.send(a);')
+        self.check(prefix + 'document.getElementById("target").innerHTML = swap(); res.send(b);', 'xss')
+
+    def test_logical_assignment_preserves_bypass_effects(self):
