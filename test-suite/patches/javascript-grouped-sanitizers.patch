+                                 'const out=[];const res={send(x){out.push(x);}};')
+                    result = subprocess.run(['node', '-e', bootstrap + source +
+                                             'console.log(JSON.stringify(out));'],
+                                            text=True, capture_output=True, timeout=10)
+                    with self.subTest(call=call, depth=depth, transform=transform):
+                        self.assertEqual(result.returncode, 0, result.stderr)
