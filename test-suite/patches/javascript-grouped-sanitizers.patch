+    @unittest.skipUnless(shutil.which('node'), 'Node.js required for independent controls')
+    def test_grouped_sanitizer_programs_match_node(self):
+        # Only these authored programs are executed; scanner input is never run.
+        calls = ('escapeHtml(req.query.html)', 'escapeHtml?.(req.query.html)')
+        for call in calls:
+            for depth in (1, 3):
+                for transform in (False, True):
