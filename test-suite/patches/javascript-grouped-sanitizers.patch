+    def test_grouped_optional_sanitizer_transformation_keeps_input(self):
+        for call in ('escapeHtml?.(req.query.html)', 'DOMPurify?.sanitize(req.query.html)',
+                     'DOMPurify.sanitize?.(req.query.html)'):
+            for depth in (1, 2, 5):
+                with self.subTest(call=call, depth=depth):
+                    self.scan('res.send(' + '(' * depth + call + ')' * depth +
+                              '.replace("&lt;", "<"));', 'xss')
+
+    def test_grouped_ordinary_sanitizer_transformation_keeps_input(self):
+        self.scan('res.send((escapeHtml(req.query.html)).replace("&lt;", "<"));', 'xss')
+        self.scan('res.send(((DOMPurify.sanitize(req.query.html))).unknown());', 'xss')
+
+    def test_grouped_sanitizer_optional_suffix_keeps_input(self):
+        self.scan('res.send(((escapeHtml?.(req.query.html)))?.replace("&lt;", "<"));', 'xss')
+        self.scan('res.send((escapeHtml(req.query.html))?.replace("&lt;", "<"));', 'xss')
+
