+def unsanitized_expression(expr: str, sink_rule: str | None) -> str:
+    """Mask only complete sanitizer call results, not their unsafe siblings.
+
+    Input has already had comments and inert literal text removed. Replacing
+    complete calls with spaces preserves offsets and cannot join identifiers.
+    An incomplete call is not evidence of sanitization.
+    """
+    regex = SANITIZERS_BY_RULE.get(sink_rule)
+    if regex is None:
+        return expr
+    out = list(expr)
+    covered_until = 0
+    for match in regex.finditer(expr):
+        if match.start() < covered_until:
+            continue
+        depth = 1
+        for index in range(match.end(), len(expr)):
+            char = expr[index]
+            if char == '(':
+                depth += 1
+            elif char == ')':
+                depth -= 1
+                if depth == 0:
+                    covered_until = index + 1
+                    out[match.start():covered_until] = ' ' * (covered_until - match.start())
+                    break
+    return ''.join(out)
+
+
+def query_argument(expr: str) -> str:
+    """Isolate SQL text: bound data never makes a dynamic query safe."""
+    stack = []
+    closing = {')': '(', ']': '[', '}': '{'}
+    for index, char in enumerate(expr):
+        if char in '([{':
+            stack.append(char)
+        elif char in closing:
+            if not stack or stack[-1] != closing[char]:
+                # Malformed syntax is not evidence for excluding the rest.
+                return expr
+            stack.pop()
+        elif char == ',' and not stack:
+            return expr[:index]
+    return expr
 
 
