+    def declare(self, scope, name, position, function_wide=False):
+        begin, end, identity = self.scopes[scope].start, self.scopes[scope].end, scope
+        if not function_wide:
+            for a, b in reversed(self.blocks):
+                if begin <= a + 1 <= position < b <= end:
+                    if a + 1 != begin:
+                        begin, end, identity = a + 1, b, len(self.scopes) + a + 1
+                    break
+        self.bindings[scope, name].add((begin, end, identity))
+
+    def binding(self, scope: int, name: str, position: int):
+        while True:
+            for begin, end, identity in sorted(self.bindings[scope, name], reverse=True):
+                if begin <= position < end:
+                    return identity, name
+            if not scope:
+                return 0, name
+            # A closure inherits the lexical environment where it is defined,
+            # not an unrelated later block in its parent's function body.
+            position, scope = self.scopes[scope].header, self.scopes[scope].parent
+
+    def references(self, expr: str, scope: int, offset: int):
+        code = lexical_views(expr)[1]
+        for match in _IDENTIFIER.finditer(code):
+            before, after = match.start() - 1, match.end()
+            while before >= 0 and code[before].isspace():
+                before -= 1
+            while after < len(code) and code[after].isspace():
+                after += 1
+            if (before >= 0 and code[before] == '.') or code[after:after + 1] == ':':
+                continue
+            yield self.binding(scope, match.group(), offset + match.start())
+
+    def without_functions(self, begin: int, end: int) -> str:
+        value = list(self.text[begin:end])
+        for scope in self.scopes[1:]:
+            if begin <= scope.header < end:
+                stop = min(end, scope.end + (not scope.implicit_return))
+                for pos in range(scope.header, stop):
+                    value[pos - begin] = '\n' if self.text[pos] == '\n' else ' '
+        return ''.join(value)
