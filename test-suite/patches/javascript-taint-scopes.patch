+            if closing is None:
+                continue
+            body = re.match(r'\s*(?::[^;={}]+)?\s*\{', self.code[closing + 1:])
+            if body:
+                add(match.start(), opening + 1, closing, closing + body.end(), match.group(1) or '')
+        for match in re.finditer(r'=>', self.code):
+            left = match.start() - 1
+            while left >= 0 and self.code[left].isspace():
+                left -= 1
+            # A parenthesized TypeScript arrow may carry a return annotation.
+            annotation = re.search(r'\)\s*:\s*[\w$\[\]<>|&., ?]+$', self.code[:left + 1])
+            if annotation:
