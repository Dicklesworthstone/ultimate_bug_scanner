+@dataclass
+class Parameter:
+    names: tuple[str, ...]
+    default: tuple[int, int] | None = None
+    rest: bool = False
+
+
+def top_level_separator(code, start, end, wanted):
+    depth = 0
+    for pos in range(start, end):
+        char = code[pos]
+        if char in '([{':
+            depth += 1
+        elif char in ')]}':
+            depth -= 1
+        elif not depth and char == wanted:
+            return pos
+    return end
+
+
+def binding_names(code: str):
+    """Names bound by simple or destructured parameter patterns, not keys."""
+    code = code.strip().removeprefix('...').strip()
+    equals = top_level_separator(code, 0, len(code), '=')
+    code = code[:equals].strip()
+    if code.startswith(('{', '[')):
+        closing = '}' if code[0] == '{' else ']'
+        # The final delimiter can precede a TypeScript annotation.
+        depth, end = 0, None
+        for pos, char in enumerate(code):
+            if char == code[0]:
+                depth += 1
+            elif char == closing:
+                depth -= 1
+                if not depth:
+                    end = pos
+                    break
+        if end is None:
+            return ()
+        names = []
+        for a, b in argument_spans(code, 1, end):
+            part = code[a:b]
+            if code[0] == '{':
+                colon = top_level_separator(part, 0, len(part), ':')
+                if colon < len(part):
+                    part = part[colon + 1:]
+            names.extend(binding_names(part))
+        return tuple(names)
+    match = re.match(r'([A-Za-z_$][\w$]*)\s*(?:[?:]|$)', code)
+    return (match.group(1),) if match else ()
+
