+def argument_spans(code: str, start: int, end: int):
+    """Split at top-level commas, retaining absolute source offsets."""
+    depth = 0
+    begin = start
+    for pos in range(start, end):
+        char = code[pos]
+        if char in '([{':
+            depth += 1
+        elif char in ')]}':
+            depth -= 1
+        elif char == ',' and depth == 0:
+            yield begin, pos
+            begin = pos + 1
+    if code[begin:end].strip():
+        yield begin, end
+
