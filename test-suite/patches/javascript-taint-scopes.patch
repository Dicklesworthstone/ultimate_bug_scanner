+class ScopedTaint:
+    """Finite source/parameter facts with call-site substitution and effects.
+
+    A parameter remains symbolic in its defining function. Calls substitute
+    actual argument facts into return and sink summaries, rather than pouring
+    all callers into one parameter variable. Cycles terminate because joins
+    only add origins; bounded provenance is evidence, not part of the lattice.
+    """
+
+    def __init__(self, index: FunctionIndex, rule: str, sinks):
+        self.index, self.rule = index, rule
+        self.facts = defaultdict(dict)
+        self.readers = defaultdict(set)
+        self.work = []
+        self.active = -1
+        self.pending = deque()
+        self.queued = set()
+        for i, scope in enumerate(index.scopes[1:], 1):
+            for param in scope.parameters:
+                for name in param.names:
+                    self.facts[('var', i, name)][('param', i, name)] = (name,)
+        for start, target, begin, end, _expr, _decl in index.records:
+            scope = index.at(start)
+            key = ('var', *index.binding(scope, target, start))
+            self.add(key, lambda a=begin, b=end, s=scope: self.evaluate(a, b, s), target)
+        for i, scope in enumerate(index.scopes[1:], 1):
+            if scope.implicit_return:
+                self.add(('return', i), lambda s=scope, i=i: self.evaluate(s.start, s.end, i))
+        for match in re.finditer(r'\breturn\b', index.code):
+            before = index.code[:match.start()].rstrip()
+            after = index.code[match.end():].lstrip()
+            if before.endswith('.') or after.startswith(':'):
+                continue
+            scope = index.at(match.start())
+            if not scope:
+                continue
+            begin = match.end()
+            # Automatic semicolon insertion makes a newline after return an
+            # empty return, not a return of the following statement.
+            following = re.match(r'[^\S\n]*', index.code[begin:]).end() + begin
+            if following < len(index.code) and index.code[following] == '\n':
+                continue
+            end = expression_end(index.code, begin)
+            self.add(('return', scope), lambda a=begin, b=end, s=scope: self.evaluate(a, b, s))
+        self.sinks = sinks
+        reachable = defaultdict(set)
+        for number, (start, begin, _rule, _label, call) in enumerate(sinks):
+            owner = index.at(start)
+            end = expression_end(index.code, begin, call=call)
+            if rule == 'js.taint.sql':
+                end = begin + len(query_argument(index.text[begin:end]))
+            reachable[owner].add(number)
+            self.add(('effect', owner, number), lambda a=begin, b=end, s=owner: self.evaluate(a, b, s))
+        calls = list(self.local_calls(0, len(index.text)))
+        callers = defaultdict(set)
+        for _start, _end, callee, _args, owner in calls:
+            callers[callee].add(owner)
+        queue = deque(reachable)
+        while queue:
+            callee = queue.popleft()
+            for owner in sorted(callers[callee]):
+                new = reachable[callee] - reachable[owner]
+                if new:
+                    reachable[owner].update(new)
+                    queue.append(owner)
+        for _start, _end, callee, args, owner in calls:
+            for number in sorted(reachable[callee]):
+                self.add(('effect', owner, number),
+                         lambda c=callee, a=args, s=owner, n=number:
+                         self.substitute(self.read(('effect', c, n)), c, a, s))
+
+    def add(self, node, operation, label=''):
+        self.work.append((node, operation, label))
+        self.enqueue(len(self.work) - 1)
+
+    def enqueue(self, number):
+        if number not in self.queued:
+            self.queued.add(number)
+            self.pending.append(number)
+
+    def read(self, node):
+        if self.active >= 0:
+            self.readers[node].add(self.active)
+        return self.facts[node]
+
+    @staticmethod
+    def extend(path, label):
+        if not label or (path and path[-1] == label):
+            return path
+        return (*path[-(PATH_LIMIT - 1):], label)
+
+    def local_calls(self, begin, end):
+        index = self.index
+        for match in re.finditer(r'(?<![\w$.])([A-Za-z_$][\w$]*)\s*\(', index.code[begin:end]):
+            start, opening = begin + match.start(), begin + match.end() - 1
+            closing = index.pairs.get(opening)
+            if closing is None or closing >= end:
+                continue
+            if any(scope.header <= start < scope.start for scope in index.scopes[1:]):
+                continue
+            owner = index.at(start)
+            callee = index.functions.get(index.binding(owner, match.group(1), start))
+            if callee is not None:
+                yield start, closing + 1, callee, tuple(argument_spans(index.code, opening + 1, closing)), owner
+
+    def substitute(self, facts, callee, args, owner, depth=0):
+        result = {}
+        scope = self.index.scopes[callee]
+        for origin, path in list(facts.items()):
+            if origin[0] == 'param' and origin[1] == callee:
+                position, parameter = next((i, p) for i, p in enumerate(scope.parameters)
+                                           if origin[2] in p.names)
+                incoming = {}
+                spread = next((i for i, (a, b) in enumerate(args)
+                               if self.index.code[a:b].lstrip().startswith('...')), None)
+                if spread is not None and position >= spread:
+                    # The expansion length is unknown: every later formal can
+                    # receive expanded data. Never interpret it as one argument.
+                    actuals = args[spread:]
+                else:
+                    actuals = args[position:] if parameter.rest else args[position:position + 1]
+                for a, b in actuals:
+                    incoming.update(self.evaluate(a, b, owner, depth + 1))
+                missing = (not actuals or (spread is not None and position >= spread)
+                           or self.index.code[actuals[0][0]:actuals[0][1]].strip() in {'undefined', 'void 0'})
+                if missing and parameter.default is not None:
+                    default = self.evaluate(*parameter.default, callee, depth + 1)
+                    # Defaults may reference earlier parameters. Those symbols
+                    # are instantiated at this same call rather than shared.
+                    if depth < 64:
+                        incoming.update(self.substitute(default, callee, args, owner, depth + 1))
+                    else:
+                        incoming.update(default)
+                for source, incoming_path in incoming.items():
+                    result.setdefault(source, self.extend(incoming_path, (scope.name or 'callback') + '()'))
+            else:
+                result.setdefault(origin, self.extend(path, (scope.name or 'callback') + '()'))
+        return result
+
+    def evaluate(self, begin, end, owner, depth=0):
+        index = self.index
+        expr = index.without_functions(begin, end)
+        shadowed = {name for (scope, name), callee in index.functions.items()
+                    if index.binding(owner, name, begin) == (scope, name)}
+        expr = unsanitized_expression(expr, self.rule, shadowed=shadowed)
+        result = {}
+        masked = list(expr)
+        covered = begin
+        if depth < 64:
+            for start, stop, callee, args, _scope in self.local_calls(begin, end):
+                if start < covered or not expr[start - begin:stop - begin].strip():
+                    continue
+                result.update(self.substitute(self.read(('return', callee)), callee, args, owner, depth))
+                for pos in range(start, stop):
+                    masked[pos - begin] = '\n' if index.text[pos] == '\n' else ' '
+                covered = stop
+        # At the nesting bound unresolved subexpressions retain source and
+        # argument flow rather than being silently replaced with clean values.
+        expr = ''.join(masked)
+        for snippet, _label in assignment_sources(expr):
+            result.setdefault(('source', begin, snippet), (snippet.strip(),))
+        for scope, name in index.references(expr, owner, begin):
+            for origin, path in self.read(('var', scope, name)).items():
+                result.setdefault(origin, path)
+        return result
+
+    def solve(self):
+        while self.pending:
+            self.active = self.pending.popleft()
+            self.queued.remove(self.active)
+            node, operation, label = self.work[self.active]
+            incoming = operation()
+            new = {origin: self.extend(path, label) for origin, path in incoming.items()
+                   if origin not in self.facts[node]}
+            if new:
+                self.facts[node].update(new)
+                for reader in sorted(self.readers[node]):
+                    self.enqueue(reader)
+        self.active = -1
+        findings = {}
+        for node, facts in self.facts.items():
+            if node[0] == 'effect':
+                for origin, path in facts.items():
+                    if origin[0] == 'source':
+                        findings.setdefault(node[2], path)
+        return findings
