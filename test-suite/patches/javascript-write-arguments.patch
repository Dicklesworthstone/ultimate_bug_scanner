+@unittest.skipUnless(os.environ.get('UBS_TAINT_E2E') == '1', 'set UBS_TAINT_E2E=1 for real scanner checks')
+class CapturedArgumentScannerTests(unittest.TestCase):
+    def test_actual_scanner_argument_and_capture_flows(self):
+        cases = [
+            ('optional-default', 'let result=req.query.html; function clear(){result="safe";} '
+             'function trigger(value=clear()){} trigger(...args); res.send(result);', {'xss'}),
+            ('single-evaluation', 'let a=req.query.html,b="safe"; '
+             'function swap(){const old=a;a=b;b=old;} function ignore(x){} '
+             'ignore(...[swap()]);res.send(a);', set()),
+            ('spread-return', 'let result=req.query.html; '
+             'function take(){const old=result;result="safe";return old;} '
+             'function first(x){return x;} res.send(first(...[take()]));', {'xss'}),
+            ('block-capture', 'function outer(){if(flag){const value=req.query.html; '
+             'function inner(){res.send(value);}}}', {'xss'}),
+        ]
+        for name, source, expected in cases:
+            with self.subTest(name=name), tempfile.TemporaryDirectory(prefix='ubs-arguments-cli-') as tmp:
+                target = Path(tmp) / 'handler.js'
+                target.write_text(source + '\n', encoding='utf-8')
+                result = subprocess.run([str(ROOT / 'ubs'), str(target), '--ci', '--only=js', '--format=json'],
+                                        cwd=tmp, capture_output=True, text=True, timeout=120)
+                artifacts = ROOT / 'test-suite/artifacts/javascript-captured-writes' / name
+                artifacts.mkdir(parents=True, exist_ok=True)
+                (artifacts / 'stdout.log').write_text(result.stdout)
+                (artifacts / 'stderr.log').write_text(result.stderr)
+                self.assertIn(result.returncode, (0, 1), result.stdout + result.stderr)
+                report = json.loads(result.stdout)
+                (artifacts / 'result.json').write_text(json.dumps(report, indent=2))
+                self.assertEqual(report['status'], 'ok', report)
+                rules = set()
+
+                def visit(value):
+                    if isinstance(value, dict):
+                        for key in ('rule', 'rule_id', 'ruleId'):
+                            rule = value.get(key)
+                            if isinstance(rule, str) and rule.startswith(('javascript.taint.', 'js.taint.')):
+                                rules.add(rule.rsplit('.', 1)[-1])
+                        for child in value.values():
+                            visit(child)
+                    elif isinstance(value, list):
+                        for child in value:
+                            visit(child)
+
+                visit(report)
+                self.assertEqual(rules, expected, (name, source, report))
+                print('JS_ARGUMENTS_E2E_PASS', name, sorted(rules), flush=True)
