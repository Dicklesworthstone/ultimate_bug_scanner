@@ -223,6 +223,72 @@ class CapturedWriteTests(unittest.TestCase):
         self.scan('let result = req.query.html; function clear() { result = "hello"; }\n'
                   'function trigger(value = clear()) {} trigger(); res.send(result);')
 
+    def test_unknown_spread_does_not_guarantee_default_cleanup(self):
+        self.scan('let result = req.query.html; function clear() { result = "hello"; }\n'
+                  'function trigger(value = clear()) {} trigger(...args); res.send(result);', 'xss')
+
+    def test_literal_spread_default_cleanup_is_definite(self):
+        self.scan('let result = req.query.html; function clear() { result = "hello"; }\n'
+                  'function trigger(value = clear()) {} trigger(...[]); res.send(result);')
+
+    def test_spread_argument_side_effect_runs_once(self):
+        self.scan('let a = req.query.html, b = "hello";\n'
+                  'function swap() { const saved = a; a = b; b = saved; }\n'
+                  'function ignore(x) {} ignore(...[swap()]); res.send(a);')
+
+    def test_nested_spread_argument_side_effect_runs_once(self):
+        self.scan('let a = req.query.html, b = "hello";\n'
+                  'function swap() { const saved = a; a = b; b = saved; }\n'
+                  'function ignore(...x) {} ignore(...[...[swap()]]); res.send(a);')
+
+    def test_spread_result_observes_pre_argument_capture(self):
+        self.scan('let result = req.query.html;\n'
+                  'function take() { const before = result; result = "hello"; return before; }\n'
+                  'function first(x) { return x; } res.send(first(...[take()]));', 'xss')
+
+    def test_default_reads_state_left_by_previous_default(self):
+        self.scan('let result; function store(x) { result = x; }\n'
+                  'function read(a = store(req.query.html), b = result) { return b; }\n'
+                  'res.send(read());', 'xss')
+
+    def test_default_resolves_capture_before_body_shadow(self):
+        self.scan('const result = req.query.html;\n'
+                  'function read(value = result) { let result = "hello"; return value; }\n'
+                  'res.send(read());', 'xss')
+
+    def test_caught_throw_then_cleanup_replaces_written_taint(self):
+        self.scan('let result; function store(x) {\n'
+                  'try { result = x; throw error; } catch (e) { result = "hello"; } }\n'
+                  'store(req.query.html); res.send(result);')
+
+    def test_throwing_write_reaches_catch_read(self):
+        self.scan('let result; function store(x) {\n'
+                  'try { result = x; throw error; } catch (e) { res.send(result); } }\n'
+                  'store(req.query.html);', 'xss')
+
+    def test_finally_cleanup_covers_throw_state(self):
+        self.scan('let result; function store(x) {\n'
+                  'try { result = x; throw error; } finally { result = "hello"; } }\n'
+                  'try { store(req.query.html); } catch (e) {} res.send(result);')
+
+    def test_nested_catch_and_finally_keep_external_write(self):
+        self.scan('let result; function store(x) { try {\n'
+                  'try { throw error; } catch(e) { result = x; return; }\n'
+                  '} finally { result += "suffix"; } }\n'
+                  'store(req.query.html); res.send(result);', 'xss')
+
+    def test_unknown_spread_propagates_stored_argument_values(self):
+        self.scan('let result; function store(a, b) { result = b; }\n'
+                  'const args = ["hello", req.query.html]; store(...args); res.send(result);', 'xss')
+
+    def test_block_capture_survives_empty_visible_parent_state(self):
+        self.scan('function outer() { if (flag) { const value = req.query.html;\n'
+                  'function inner() { res.send(value); } } }', 'xss')
+
+    def test_block_capture_survives_parent_return_paths(self):
+        self.scan('function outer() { if (flag) { const value = req.query.html;\n'
+                  'function inner() { res.send(value); } return; } else { return; } }', 'xss')
+
 
