+class BoundClassMethodFlowTests(SourceTest):
+    def scan(self, source):
+        ast.parse(textwrap.dedent(source).lstrip('\n'))
+        return super().scan(source)
+
+    def test_implicit_receiver_does_not_consume_the_source_argument(self):
+        for sink, rule in (('eval(code)', 'eval'), ('os.system(code)', 'command'),
+                           ('cursor.execute(code)', 'sql'), ('HttpResponse(code)', 'xss')):
+            with self.subTest(sink=sink):
+                self.assert_rules(f'''
+                    class Service:
+                        @classmethod
+                        def run(owner, code):
+                            {sink}
+                    Service.run(input())
+                ''', rule)
+
+    def test_sources_and_clean_returns_keep_method_identity(self):
+        self.assert_rules('''
+            class Service:
+                @classmethod
+                def read(cls):
+                    return input()
+            eval(Service.read())
+        ''', 'eval')
+        self.assert_rules('''
+            class Service:
+                @classmethod
+                def clean(cls, ignored):
+                    return 'fixed'
+            eval(Service.clean(input()))
+        ''')
+
+    def test_receiver_dispatches_to_static_and_bound_helpers(self):
+        self.assert_rules('''
+            class Service:
+                @staticmethod
+                def sink(value):
+                    eval(value)
+                @classmethod
+                def middle(cls, value):
+                    cls.sink(value)
+                @classmethod
+                def run(cls, value):
+                    cls.middle(value)
+            Service.run(input())
+        ''', 'eval')
+
+    def test_aliases_callbacks_and_returned_bound_methods(self):
+        for invocation in ('alias(input())', 'apply(alias, input())',
+                           'choose()(input())', 'apply(choose(), input())'):
+            with self.subTest(invocation=invocation):
+                self.assert_rules(textwrap.dedent('''
+                    class Service:
+                        @classmethod
+                        def run(cls, code):
+                            eval(code)
+                    def apply(callback, value):
+                        return callback(value)
+                    def choose():
+                        return Service.run
+                    alias = Service.run
+                ''') + '\n' + invocation, 'eval')
+
+    def test_positional_only_keyword_and_literal_unpacking(self):
+        for invocation, expected in (("Service.run(code=input())", ('eval',)),
+                                     ("Service.run(*[input()])", ('eval',)),
+                                     ("Service.run(**{'code': input()})", ('eval',)),
+                                     ("Service.run()", ())):
+            with self.subTest(invocation=invocation):
+                self.assert_rules(textwrap.dedent('''
+                    class Service:
+                        @classmethod
+                        def run(owner, /, code='1'):
+                            eval(code)
+                ''') + '\n' + invocation, *expected)
+
