+            while pending:
+                engine, edges = pending[-1]
+                dependency = next(edges, None)
+                if dependency is not None:
+                    if dependency not in indices:
+                        indices[dependency] = lowlinks[dependency] = len(indices)
+                        active.add(dependency)
