 class InstanceMethodFlowTests(SourceTest):
+    def test_captured_method_reads_class_storage_at_invocation(self):
+        self.assert_rules('''
+            class Box:
+                value = 'fixed'
+                def read(self): return self.value
+            box = Box()
+            saved = box.read
+            Box.value = input()
+            eval(saved())
+        ''', 'eval')
+
+    def test_returned_method_reads_class_storage_at_invocation(self):
+        self.assert_rules('''
+            class Box:
+                value = 'fixed'
+                def read(self): return self.value
+            def make(): return Box().read
+            saved = make()
+            Box.value = input()
+            eval(saved())
+        ''', 'eval')
+
+    def test_callback_reads_class_storage_changed_inside_helper(self):
+        self.assert_rules('''
+            class Box:
+                value = 'fixed'
+                def read(self): return self.value
+            saved = Box().read
+            def invoke(callback):
+                Box.value = input()
+                return callback()
+            eval(invoke(saved))
+        ''', 'eval')
+
+    def test_suspended_instance_method_reads_later_type_writes(self):
+        self.assert_rules('''
+            class Box:
+                value = 'fixed'
+                async def read(self): return self.value
+            async def route():
+                pending = Box().read()
+                Box.value = input()
+                eval(await pending)
+        ''', 'eval')
+
+    def test_default_instance_reads_current_class_storage(self):
+        self.assert_rules('''
+            class Box:
+                value = 'fixed'
+                def read(self): return self.value
+            def invoke(box=Box()): return box.read()
+            Box.value = input()
+            eval(invoke())
+        ''', 'eval')
+
+    def test_current_class_storage_does_not_contaminate_literal_returns(self):
+        self.assert_rules('''
+            class Box:
+                value = 'fixed'
+                def read(self): return 'constant'
+            saved = Box().read
+            Box.value = input()
+            eval(saved())
+        ''')
+
+    def test_captured_class_storage_retains_sink_specific_sanitizers(self):
+        self.assert_rules('''
+            class Box:
+                value = 'fixed'
+                def read(self): return html.escape(self.value)
+            saved = Box().read
+            Box.value = input()
+            HttpResponse(saved())
+            eval(saved())
+        ''', 'eval')
+
