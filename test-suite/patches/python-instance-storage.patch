+    @staticmethod
+    def live_fact(binding, fact, references, state):
+        """Read both object and type storage before revoking a nominal proof.
+
+        Capturing a method freezes its function, not its receiver's fields.
+        A suspended method or callback must also observe later class writes;
+        invalidating the instance identity must not erase that provenance.
+        """
+        storage = set(references)
+        for value in _binding_choices(binding):
+            if isinstance(value, _Instance):
+                storage.update(value.class_references)
+                storage.add(value.owner)
+            elif isinstance(value, ast.ClassDef):
+                storage.add(value)
+        return join_facts(fact, *(state.heap.get(ref, CLEAN) for ref in storage))
