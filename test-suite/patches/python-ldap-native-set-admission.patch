+                            command = (*command, '--report-json=' + str(ledger))
+                        command = (*command, str(selected))
+                        result = subprocess.run(command, cwd=work, env=env, capture_output=True,
+                                                text=True, timeout=180,
+                                                preexec_fn=prevent_child_deletion)
+                        output.with_suffix('.stdout').write_text(result.stdout, encoding='utf-8')
+                        output.with_suffix('.stderr').write_text(result.stderr, encoding='utf-8')
+                        context = (command, result.stdout, result.stderr)
+                        self.assertEqual(result.returncode, 2 if partial else 0, context)
+                        payload = json.loads(result.stdout)
+                        if fmt == 'json':
+                            self.assertEqual(payload['status'], 'partial' if partial else 'ok', context)
+                            counts = payload if module else payload['totals']
+                            self.assertEqual([counts[key] for key in ('files', 'critical', 'warning', 'info')],
+                                             [1, len(expected), 0, 0], context)
+                            rows = payload.get('findings', [])
+                            if module:
+                                self.assertEqual([row['rule'] for row in rows],
+                                                 [item[0] for item in expected], context)
+                                samples = [sample for row in rows for sample in row['samples']]
+                                self.assertEqual([(Path(sample['file']).name, sample['line']) for sample in samples],
+                                                 [(item[1], item[2]) for item in expected], context)
+                            else:
+                                self.assertEqual([(row['rule_id'], Path(row['file']).name, row['line'],
+                                                   row['col'], row['severity']) for row in rows], expected, context)
+                            errors = (payload.get('analysis_errors', []) if module else
+                                      [error for scanner in payload['scanners']
+                                       for error in scanner.get('analysis_errors', [])])
+                        else:
+                            rows = [row for run in payload['runs'] for row in run.get('results', [])]
+                            sites = []
+                            for row in rows:
+                                location = row['locations'][0]['physicalLocation']
+                                region = location['region']
+                                sites.append((row['ruleId'], Path(location['artifactLocation']['uri']).name,
+                                              region['startLine'], region['startColumn'], row['level']))
+                            self.assertEqual(sites, [(rule, name, line, col, 'error')
+                                                     for rule, name, line, col, severity in expected], context)
+                            invocations = [item for run in payload['runs'] for item in run.get('invocations', [])]
+                            if partial:
+                                self.assertTrue(invocations, context)
+                                self.assertTrue(all(item['executionSuccessful'] is False
+                                                    for item in invocations), context)
+                            else:
+                                self.assertTrue(all(item.get('executionSuccessful') is not False
+                                                    for item in invocations), context)
+                            errors = [error for invocation in invocations
+                                      for notification in invocation.get('toolExecutionNotifications', [])
+                                      for error in notification.get('properties', {}).get('analysis_errors', [])]
+                        if module:
+                            records = [json.loads(line) for line in ledger.read_text(encoding='utf-8').splitlines()]
+                            self.assertEqual([(row['rule'], Path(row['path']).name, row['line'],
+                                               row['col'], row['severity']) for row in records], expected, context)
+                            self.assertTrue(all(row['suppressed'] is False for row in records), context)
+                            for row in records:
+                                self.assertIn('request.args', row['message'])
+                                self.assertIn('LDAP distinguished name', row['message'])
+                        if partial:
+                            # LDAP irrelevance must not hide an independent analyzer's failure.
+                            self.assertTrue(any(error['stage'].startswith('taint_py (')
+                                                and error.get('semantic') is True for error in errors), context)
+                        else:
+                            self.assertEqual(errors, [], context)
+                        self.assertEqual(any('incomplete LDAP analysis' in error.get('message', '')
+                                             for error in errors), directory, context)
+                        if directory:
+                            self.assertIn('incomplete LDAP analysis', result.stdout + result.stderr, context)
+                        else:
+                            self.assertNotIn('incomplete LDAP analysis', result.stdout + result.stderr, context)
+                        print('PYTHON_LDAP_SET_PUBLIC', label, module, fmt, 'PASS', flush=True)
+
