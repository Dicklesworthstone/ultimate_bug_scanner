def sha(value):
    return hashlib.sha256(value).hexdigest()


def load(label, path):
    spec = importlib.util.spec_from_file_location('ordinary_acceptance_' + label, path)
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    return module


def scan(module, path):
    started = time.perf_counter()
    rows, error, components = [], None, []
    try:
        for row in module.scan_file_findings(path):
            rows.append(list(row))
    except Exception as exc:
        error = type(exc).__name__ + ': ' + str(exc)
        components = list(getattr(exc, 'components', ()))
    return {'status': 'partial' if error else 'complete', 'findings': rows,
            'error': error, 'components': components,
            'seconds': time.perf_counter() - started}


def isolated_scan(analyzer, path):
    process = subprocess.run([sys.executable, '-B', str(Path(__file__).resolve()),
                              '--worker', str(analyzer), str(path)],
                             capture_output=True, text=True, timeout=20)
    if process.returncode != 0:
        return {'status': 'harness-error', 'findings': [], 'error': process.stderr,
                'components': [], 'seconds': None}
    return json.loads(process.stdout)


def main():
    label = sys.argv[1]
    destination = HERE / label
    destination.mkdir(exist_ok=False)
    baseline_path = HERE / 'baseline_taint_py.py'
    candidate_path = destination / 'candidate_taint_py.py'
    candidate_path.write_bytes((ROOT / 'modules/helpers/ubs_core/analyzers/taint_py.py').read_bytes())
    report = {'analyzed_programs_executed': False,
              'baseline_sha256': sha(baseline_path.read_bytes()),
              'candidate_sha256': sha(candidate_path.read_bytes()), 'runtime': sys.version, 'rows': []}
    for name, group, rule, source in CASES:
        source = textwrap.dedent(source).lstrip('\n')
        ast.parse(source, filename=name)
        path = destination / (name + '.py')
        path.write_text(source)
        expected = [] if rule is None else [('py.taint.' + rule, index)
            for index, line in enumerate(source.splitlines(), 1) if line.strip().startswith('eval(')]
        row = {'name': name, 'group': group, 'source': source, 'source_sha256': sha(source.encode()),
               'expected_complete': group != 'unsupported', 'expected_findings': expected,
               'baseline': isolated_scan(baseline_path, path),
               'candidate': isolated_scan(candidate_path, path)}
        for arm in ('baseline', 'candidate'):
            result = row[arm]
            observed = [(item[0], item[1]) for item in result['findings']]
            result['accepted'] = ((result['status'] == 'partial') if group == 'unsupported'
                                  else result['status'] == 'complete' and observed == expected)
        report['rows'].append(row)
        print(json.dumps({'name': name, 'group': group,
                          **{arm: {key: row[arm][key] for key in ('status', 'findings', 'accepted')}
                             for arm in ('baseline', 'candidate')}}), flush=True)
    (destination / 'report.json').write_text(json.dumps(report, indent=2, default=str) + '\n')
    print(json.dumps({'report': str(destination / 'report.json'),
                      'baseline_sha256': report['baseline_sha256'],
                      'candidate_sha256': report['candidate_sha256']}))


if __name__ == '__main__':
    if len(sys.argv) > 1 and sys.argv[1] == '--worker':
        print(json.dumps(scan(load('worker', Path(sys.argv[2])), Path(sys.argv[3])), default=str))
    else:
        main()
