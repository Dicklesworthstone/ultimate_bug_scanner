+            source = (f'{declaration}\ncode = input()\n'
+                      f'chosen = {callee}(code for unused in [0])\n'
+                      "code = 'fixed'\neval(chosen)\n")
+            with self.subTest(declaration=declaration):
+                self.assert_runtime_sites(source, ['UNTRUSTED'], 5)
+
