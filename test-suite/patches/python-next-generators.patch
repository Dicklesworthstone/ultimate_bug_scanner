+            try:
+                next((replace() for unused in [0]), 'fallback')
+            except RuntimeError:
+                eval(code)
+        ''', ['UNTRUSTED'], 9)
+
+    def test_captured_result_survives_later_rebinding(self):
+        for initial, later, expected, lines in (
+            ('input()', "'fixed'", ['UNTRUSTED'], (4,)),
+            ("'fixed'", 'input()', ['fixed'], ()),
