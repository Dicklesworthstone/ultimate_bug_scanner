+                                          'chosen = next(code for unused in [0])\n'
+                                          f'code = {later}\neval(chosen)\n', expected, *lines)
+
+    def test_binding_verified_aliases_include_readonly_builtin_modules(self):
+        for declaration, callee in (
+            ('consume = next', 'consume'),
+            ('from builtins import next as consume', 'consume'),
+            ('import builtins', 'builtins.next'),
+            ('import builtins as native', 'native.next'),
