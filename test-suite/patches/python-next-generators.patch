                         self.scan(source)
 
 
+class NextGeneratorCompletionTests(SourceTest):
+    def assert_runtime_sites(self, source, observed, *lines):
+        source = textwrap.dedent(source).lstrip('\n')
+        actual = []
+        exec(source, {'input': lambda: 'UNTRUSTED', 'eval': actual.append})
+        self.assertEqual(actual, observed)
+        self.assertEqual(sorted((item['rule'], item['line']) for item in self.scan(source)),
+                         [('python.taint.eval', line) for line in sorted(lines)])
+
+    def test_only_first_yield_changes_the_result_and_enclosing_binding(self):
+        for values, expected, lines in (
+            ("['fixed', input()]", ['fixed', 'fixed'], ()),
+            ("[input(), 'fixed']", ['UNTRUSTED', 'UNTRUSTED'], (3, 4)),
+        ):
+            source = ("code = 'initial'\n"
+                      f"chosen = next((code := value) for value in {values})\n"
+                      "eval(chosen)\neval(code)\n")
+            with self.subTest(values=values):
+                self.assert_runtime_sites(source, expected, *lines)
+
+    def test_skipped_filters_and_nested_clauses_stop_after_first_accepted_value(self):
+        self.assert_runtime_sites('''
+            code = 'fixed'
+            chosen = next((code := input()) for outer in [0, 1] for inner in [0, 1])
+            eval(chosen)
+            eval(code)
+        ''', ['UNTRUSTED', 'UNTRUSTED'], 3, 4)
+        self.assert_runtime_sites('''
+            code = 'fixed'
+            chosen = next(((code := input()) for unused in [0] if False), 'fallback')
+            eval(chosen)
+            eval(code)
+        ''', ['fallback', 'fixed'])
+        self.assert_runtime_sites('''
+            code = 'fixed'
+            chosen = next(('selected' for unused in [0, 1] if (code := input())), 'fallback')
+            eval(chosen)
+            eval(code)
+        ''', ['selected', 'UNTRUSTED'], 4)
+
+    def test_exhaustion_returns_default_or_raises_stop_iteration(self):
+        for values in ('[]', '[0] if False'):
+            with self.subTest(values=values):
+                self.assert_runtime_sites(f'''
+                    code = input()
+                    chosen = next(((code := 'fixed') for unused in {values}), 'fallback')
+                    eval(chosen)
+                    eval(code)
+                ''', ['fallback', 'UNTRUSTED'], 4)
+                self.assert_runtime_sites(f'''
+                    code = input()
+                    try:
+                        next((code := 'fixed') for unused in {values})
+                        eval(code)
+                    except StopIteration:
+                        eval(code)
+                ''', ['UNTRUSTED'], 6)
+
+    def test_nonempty_next_does_not_enter_the_exhaustion_handler(self):
+        self.assert_runtime_sites('''
+            code = input()
+            try:
+                chosen = next('fixed' for unused in [0])
+            except StopIteration:
+                eval(code)
+            eval(chosen)
+        ''', ['fixed'])
+
+    def test_conditional_and_boolean_yields_do_not_execute_skipped_effects(self):
+        for expression in ("(code := input()) if False else 'fixed'",
+                           "'fixed' if True else (code := input())",
+                           "'fixed' or (code := input())",
+                           "'' and (code := input())"):
+            with self.subTest(expression=expression):
+                self.assert_runtime_sites("code = 'initial'\n"
+                                          f"next({expression} for unused in [0])\n"
+                                          "eval(code)\n", ['initial'])
+        for expression in ("(code := input()) if True else 'fixed'",
+                           "'fixed' if False else (code := input())",
+                           "'' or (code := input())",
+                           "'fixed' and (code := input())"):
+            with self.subTest(expression=expression):
+                self.assert_runtime_sites("code = 'initial'\n"
+                                          f"next({expression} for unused in [0])\n"
+                                          "eval(code)\n", ['UNTRUSTED'], 3)
+
+    def test_global_and_nonlocal_helpers_complete_before_the_result(self):
+        self.assert_runtime_sites('''
+            code = 'fixed'
+            def replace():
+                global code
+                code = input()
+                return 'chosen'
+            chosen = next(replace() for unused in [0, 1])
+            eval(chosen)
+            eval(code)
+        ''', ['chosen', 'UNTRUSTED'], 8)
+        self.assert_runtime_sites('''
+            def run():
+                code = 'fixed'
+                def replace():
+                    nonlocal code
+                    code = input()
+                    return 'chosen'
+                chosen = next(replace() for unused in [0, 1])
+                eval(chosen)
+                eval(code)
+            run()
+        ''', ['chosen', 'UNTRUSTED'], 9)
+
+    def test_exception_before_first_yield_keeps_preceding_writes(self):
+        self.assert_runtime_sites('''
+            code = 'fixed'
+            def replace():
+                global code
+                code = input()
+                raise ValueError('stop')
+            try:
+                next(replace() for unused in [0])
+                eval('unreachable')
+            except ValueError:
+                eval(code)
+        ''', ['UNTRUSTED'], 10)
+
+    def test_stop_iteration_raised_inside_generator_is_runtime_error(self):
+        self.assert_runtime_sites('''
+            code = 'fixed'
+            def replace():
+                global code
+                code = input()
