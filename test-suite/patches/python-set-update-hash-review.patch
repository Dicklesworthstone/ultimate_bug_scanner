+    def set_update_argument_offsets(self, call):
+        """Find possible native set.update targets for refusal only.
+
+        A may-alias authorizes no receiver, effect or exhaustion proof. Loaded
+        binding sites distinguish saved origins from later overwrites; unknown
+        snapshots retain lexical alternatives instead of certifying a target.
+        """
+        bindings = self.ownership_bindings()
+        constructors = {('unbound', 'set'), ('import', 'builtins.set')}
+        pending, visited, offsets = [(call.func, False)], set(), set()
+        while pending:
+            expression, receiver = pending.pop()
+            if (expression, receiver) in visited:
+                continue
+            self.step()
+            visited.add((expression, receiver))
+            if receiver:
+                if (isinstance(expression, ast.Set)
+                        or self.value_kind(expression)[0] == 'set'
+                        or isinstance(expression, ast.Call)
+                        and bindings.resolve(expression.func) in constructors):
+                    offsets.add(0)
+            elif isinstance(expression, ast.Attribute) and expression.attr == 'update':
+                if bindings.resolve(expression.value) in constructors:
+                    offsets.add(1)
+                else:
+                    pending.append((expression.value, True))
+            if isinstance(expression, ast.Name):
+                scope = bindings.sql_binding_cell(expression.id, bindings.scope_of.get(expression))
