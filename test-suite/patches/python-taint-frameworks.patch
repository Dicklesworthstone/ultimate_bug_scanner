+            'typing.Annotated', 'typing_extensions.Annotated'}:
+        parts = node.slice.elts if isinstance(node.slice, ast.Tuple) else [node.slice]
+        for part in reversed(parts):
+            found = _framework_input(part, bindings)
+            if found is not None:
+                return found
+    return None
