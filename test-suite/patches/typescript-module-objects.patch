+    @staticmethod
+    def commonjs_object_bounds(code, pairs, begin, end):
+        """Peel only complete parentheses, not commas/calls/other expressions."""
+        while True:
+            while begin < end and code[begin].isspace():
+                begin += 1
+            while end > begin and code[end - 1].isspace():
+                end -= 1
+            if code[begin:begin + 1] != '(' or pairs.get(begin) != end - 1:
+                break
+            begin, end = begin + 1, end - 1
+        if code[begin:begin + 1] == '{' and pairs.get(begin) == end - 1:
+            return begin, end
+        return None
+
+    @staticmethod
+    def commonjs_member_name(raw, shorthand):
+        """Normalize proven data keys without evaluating computed expressions."""
+        raw = raw.strip()
+        if re.fullmatch(_IDENTIFIER, raw):
+            return raw
+        if shorthand:
+            return None  # Quoted and computed names require a value.
+        if raw.startswith('[') and raw.endswith(']'):
+            raw = raw[1:-1].strip()
+            if re.fullmatch(_IDENTIFIER, raw):
+                return None  # [name] reads a variable; it is not the key 'name'.
+        match = re.fullmatch(r"'([^'\\\r\n]*)'|\"([^\"\\\r\n]*)\"", raw)
+        if match is not None:
+            return match.group(1) if match.group(1) is not None else match.group(2)
+        return raw if re.fullmatch(r'0|[1-9][0-9]*', raw) else None
+
