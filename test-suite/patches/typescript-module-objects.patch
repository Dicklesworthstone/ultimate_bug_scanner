+    def commonjs_object_bounds(code, pairs, begin, end):
+        """Peel only complete parentheses, not commas/calls/other expressions."""
+        while True:
+            while begin < end and code[begin].isspace():
+                begin += 1
+            while end > begin and code[end - 1].isspace():
+                end -= 1
+            if code[begin:begin + 1] != '(' or pairs.get(begin) != end - 1:
+                break
+            begin, end = begin + 1, end - 1
+        if code[begin:begin + 1] == '{' and pairs.get(begin) == end - 1:
+            return begin, end
+        return None
