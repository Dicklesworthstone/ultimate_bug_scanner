#!/usr/bin/env python3
"""Repository-local UBS scan service backed by the ordinary scanner.

The existing scanner is the source of truth. Cache hits require matching
repository/runtime bytes and invocation environment; misses run the normal CLI.
This is the first K4 transport/cache increment, not an in-process analysis engine.
"""
from __future__ import annotations

import argparse
from collections import OrderedDict, deque
from concurrent.futures import ThreadPoolExecutor
import ctypes
import errno
import hashlib
import json
import os
from pathlib import Path
import signal
import selectors
import shutil
import socket
import stat
import struct
import subprocess
import sys
import threading
import time
import uuid

try:
    import fcntl
except ImportError:
    fcntl = None

PROTOCOL = 1
MAX_REQUEST = 256 * 1024
MAX_OUTPUT = 8 * 1024 * 1024
MAX_RESPONSE = 2 * MAX_OUTPUT + 65536
MAX_SNAPSHOT = 128 * 1024 * 1024
MAX_SNAPSHOT_ENTRIES = 20000
MAX_CLIENTS = 32
MAX_PENDING_SCANS = 8
IO_TIMEOUT = 3.0
QUEUE_TIMEOUT = 3.0
FORMATS = {'text', 'json', 'jsonl', 'sarif'}
TRANSIENT_ENV = {'_', 'SHLVL', 'PWD', 'OLDPWD', 'TERM', 'COLUMNS', 'LINES'}


class ServiceError(Exception):
    pass


def identity(path: Path) -> tuple[int, int]:
    info = path.stat()
    return info.st_dev, info.st_ino


def peer_uid(connection: socket.socket) -> int:
    """Kernel-authenticated identity on Linux and BSD/macOS; otherwise refuse."""
    if hasattr(socket, 'SO_PEERCRED'):
        credentials = connection.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize('3i'))
        return struct.unpack('3i', credentials)[1]
    libc = ctypes.CDLL(None, use_errno=True)
    function = getattr(libc, 'getpeereid', None)
    if function is None:
        raise ServiceError('This platform has no supported Unix peer-credential API')
    uid, gid = ctypes.c_uint(), ctypes.c_uint()
    function.argtypes = [ctypes.c_int, ctypes.POINTER(ctypes.c_uint), ctypes.POINTER(ctypes.c_uint)]
    function.restype = ctypes.c_int
    if function(connection.fileno(), ctypes.byref(uid), ctypes.byref(gid)) != 0:
        raise OSError(ctypes.get_errno(), 'getpeereid failed')
    return uid.value


def private_directory(path: Path) -> Path:
    path.mkdir(mode=0o700, parents=True, exist_ok=True)
    info = path.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
        raise ServiceError(f'Service directory must be owned by this uid with mode 0700: {path}')
    return path


def socket_path(root: Path, *, create: bool = False) -> Path:
    runtime = os.environ.get('XDG_RUNTIME_DIR')
    base = Path(runtime) if runtime else Path(os.environ.get('XDG_CACHE_HOME', str(Path.home() / '.cache')))
    directory = base / 'ubs-daemon'
    if create:
        private_directory(directory)
    elif directory.exists() or directory.is_symlink():
        info = directory.lstat()
        if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
            raise ServiceError(f'Unsafe service directory: {directory}')
    key = hashlib.sha256(os.fsencode(str(root))).hexdigest()[:24]
    path = directory / (key + '.sock')
    if len(os.fsencode(str(path))) > 100:
        raise ServiceError('Unix socket path is too long; select a shorter XDG_RUNTIME_DIR')
    return path


def environment_key() -> str:
    # Do not transmit environment values (which may contain credentials).
    # Unknown variables participate, so tool-specific policy cannot be reused
    # across differing callers. Ignore only shell/terminal bookkeeping.
    environment = {key: value for key, value in os.environ.items() if key not in TRANSIENT_ENV}
    return hashlib.sha256(json.dumps(environment, sort_keys=True).encode()).hexdigest()


def decode_message(raw: bytes | bytearray) -> dict:
    def reject_constant(value):
        raise ValueError(value)

    try:
        value = json.loads(raw, parse_constant=reject_constant)
    except (ValueError, UnicodeError, RecursionError) as exc:
        raise ServiceError('Invalid JSON service message') from exc
    if not isinstance(value, dict):
        raise ServiceError('Service message must be an object')
    return value


def receive(connection: socket.socket, limit: int) -> dict:
    def exact(size: int) -> bytes:
        chunks = bytearray()
        while len(chunks) < size:
            data = connection.recv(size - len(chunks))
            if not data:
                raise ServiceError('Incomplete service message')
            chunks.extend(data)
        return bytes(chunks)
    size = struct.unpack('!I', exact(4))[0]
    if size == 0 or size > limit:
        raise ServiceError('Service message exceeds the permitted size')
    return decode_message(exact(size))


def encode_message(value: dict) -> bytes:
    raw = json.dumps(value, ensure_ascii=True, separators=(',', ':')).encode()
    if len(raw) > MAX_RESPONSE:
        raise ServiceError('Encoded scanner response exceeds the permitted size')
    return struct.pack('!I', len(raw)) + raw


def send(connection: socket.socket, value: dict) -> None:
    connection.sendall(encode_message(value))


def failure(message: str) -> dict:
    return {'protocol': PROTOCOL, 'exit_code': 2, 'stdout': '', 'stderr': message + '\n'}


def check_cancelled(cancel: threading.Event | None) -> None:
    if cancel is not None and cancel.is_set():
        raise ServiceError('Scanner cancelled')


def validate_request_id(value) -> str:
    if not isinstance(value, str) or not 1 <= len(value) <= 64 \
            or any(char not in 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-' for char in value):
        raise ServiceError('Request id must be 1 to 64 ASCII letters, digits, underscores or hyphens')
    return value


def validate_scan(root: Path, request: dict) -> tuple[list[Path], list[str]]:
    allowed = {'protocol', 'op', 'root', 'environment', 'scanner', 'paths', 'format', 'profile',
               'fail_on_warning', 'request_id', 'selection'}
    if set(request) - allowed:
        raise ServiceError('Unknown scan request fields')
    if 'request_id' in request:
        validate_request_id(request['request_id'])
    selection = request.get('selection', 'files')
    if not isinstance(selection, str) or selection not in {'files', 'directory', 'staged', 'diff'}:
        raise ServiceError('Unknown source selection')
    paths = request.get('paths')
    if not isinstance(paths, list):
        raise ServiceError('Source paths must be a list')
    if selection == 'files' and not 1 <= len(paths) <= 256:
        raise ServiceError('A scan requires 1 to 256 explicit source files')
    if selection == 'directory' and len(paths) != 1:
        raise ServiceError('A directory scan requires exactly one directory')
    if selection in {'staged', 'diff'} and paths:
        raise ServiceError('Git selection cannot be combined with explicit paths')
    selected = []
    for name in paths:
        if not isinstance(name, str) or not name or '\x00' in name:
            raise ServiceError('Invalid source path')
        path = (root / name).resolve(strict=True)
        if not path.is_relative_to(root):
            raise ServiceError(f'Source is outside the served repository: {name}')
        mode = path.stat().st_mode
        if selection == 'directory':
            if not stat.S_ISDIR(mode):
                raise ServiceError(f'Source is not a directory: {name}')
        elif not stat.S_ISREG(mode):
            raise ServiceError(f'Source is not a regular file: {name}')
        if path not in selected:
            selected.append(path)
    format_ = request.get('format', 'json')
    profile = request.get('profile')
    warnings = request.get('fail_on_warning', False)
    if not isinstance(format_, str) or format_ not in FORMATS:
        raise ServiceError('Unsupported report format')
    if profile not in (None, 'strict', 'loose') or type(warnings) is not bool:
        raise ServiceError('Invalid scan policy')
    options = ['--ci', '--no-auto-update', '--no-color', '--format=' + format_]
    if profile:
        options.append('--profile=' + profile)
    if warnings:
        options.append('--fail-on-warning')
    if selection in {'staged', 'diff'}:
        # The runner owns Git file selection, including index contents and
        # ignore policy. Never replace --staged with worktree filenames. It
        # may promote a subdirectory to the Git root, so refuse such a scope
        # rather than silently scanning outside the served repository.
        try:
            git = subprocess.run(['git', '-C', str(root), 'rev-parse', '--show-toplevel'],
                                 capture_output=True, timeout=IO_TIMEOUT, check=False)
        except subprocess.TimeoutExpired as exc:
            raise ServiceError('Git repository discovery timed out') from exc
        if git.returncode or not git.stdout.endswith(b'\n'):
            raise ServiceError('Git selection requires a Git worktree root')
        git_root = Path(os.fsdecode(git.stdout[:-1])).resolve(strict=True)
        if git_root != root:
            raise ServiceError('Git selection requires --repo to be the Git worktree root')
        selected = [root]
        options.append('--' + selection)
    return selected, options


def snapshot(root: Path, scanner: Path, *, cancel: threading.Event | None = None) -> str | None:
    """Conservative bounded content snapshot, not an mtime-only clean shortcut.

    Include the entire repository and runtime, even ignored project files. Git
    object storage is immutable and not a scan input; HEAD/index/config/refs
    are included. External symlinks or large/special-file trees disable reuse.
    Any uncertainty is a cache miss, never a clean result.
    """
    check_cancelled(cancel)
    if os.environ.get('UBS_MODULE_DIR') or os.environ.get('UBS_VERIFIED_ASSET_DIR'):
        return None  # The override can select runtime assets outside this graph.
    if any(name.startswith('GIT_') for name in os.environ):
        return None  # Git can redirect its index, metadata or config externally.
    if any((parent / '.git').exists() for parent in root.parents):
        return None  # A subdirectory can inherit selection policy outside root.
    digest = hashlib.sha256()
    total = 0
    seen = set()
    roots = [root, scanner, scanner.parent / 'modules']
    config = Path(os.environ.get('XDG_CONFIG_HOME', str(Path.home() / '.config')))
    # Global Git excludes can change file selection without a project edit.
    for extra in (Path.home() / '.gitconfig', Path.home() / '.gitignore', config / 'git'):
        digest.update(os.fsencode(str(extra)) + (b'1' if extra.exists() else b'0'))
        if extra.exists():
            roots.append(extra)
    # Track tool replacement and ordinary in-place upgrades (ctime cannot be
    # restored with utime). Source/runtime inputs themselves are byte-hashed.
    for name in ('bash', 'python3', 'jq', 'rg', 'ast-grep', 'node', 'go', 'ruff', 'semgrep', 'shellcheck', 'typos'):
        executable = shutil.which(name)
        digest.update(name.encode() + b'\0' + os.fsencode(executable or '') + b'\0')
        if executable:
            try:
                info = Path(executable).stat()
                digest.update(str((info.st_dev, info.st_ino, info.st_size, info.st_mtime_ns, info.st_ctime_ns)).encode())
            except OSError:
                return None
    try:
        for base in roots:
            if not base.exists():
                return None
            pending = [base]
            while pending:
                check_cancelled(cancel)
                path = pending.pop()
                if path in seen:
                    continue
                seen.add(path)
                if len(seen) > MAX_SNAPSHOT_ENTRIES:
                    return None
                info = path.lstat()
                digest.update(os.fsencode(str(path)) + b'\0')
                digest.update(str((info.st_dev, info.st_ino, info.st_mode, info.st_size)).encode() + b'\0')
                if stat.S_ISLNK(info.st_mode):
                    # A symlink can point at changing input outside this graph.
                    return None
                if stat.S_ISDIR(info.st_mode):
                    if path.parent.name == '.git' and path.name in {'objects', 'logs'}:
                        continue
                    children = []
                    remaining = MAX_SNAPSHOT_ENTRIES - len(seen) - len(pending)
                    for child in path.iterdir():
                        if len(children) >= remaining:
                            return None
                        children.append(child)
                    pending.extend(sorted(children, reverse=True))
                elif stat.S_ISREG(info.st_mode):
                    if path.name == '.git':
                        return None  # Linked worktree metadata is outside root.
                    if info.st_size > MAX_SNAPSHOT - total:
                        return None
                    before = (info.st_ino, info.st_size, info.st_mtime_ns, info.st_ctime_ns)
                    git_config = (path.name == '.gitconfig' or path == config / 'git' / 'config'
                                  or path.parent.name == '.git' and path.name in {'config', 'config.worktree'})
                    config_tail = b''
                    with path.open('rb') as stream:
                        while chunk := stream.read(65536):
                            check_cancelled(cancel)
                            total += len(chunk)
                            if total > MAX_SNAPSHOT:
                                return None
                            digest.update(chunk)
                            if git_config:
                                # Include/exclude targets are outside this
                                # graph. Keep token matching bounded even for
                                # oversized or concurrently growing config.
                                contents = (config_tail + chunk).lower()
                                if b'include' in contents or b'excludesfile' in contents:
                                    return None
                                config_tail = contents[-16:]
                    info = path.stat()
                    if before != (info.st_ino, info.st_size, info.st_mtime_ns, info.st_ctime_ns):
                        return None
                    digest.update(b'\0')
                else:
                    return None
        return digest.hexdigest()
    except OSError:
        return None


def run_scanner(root: Path, scanner: Path, paths: list[Path], options: list[str], timeout: float,
                *, cancel: threading.Event | None = None) -> dict:
    """Supervise one process group with bounded pipes, time and cancellation.

    Drain both streams through EOF, including helpers outliving the runner.
    Unlike polling temporary-file sizes, pipes apply backpressure before a
    noisy scanner can exhaust the filesystem between limit checks.
    """
    if cancel is not None and cancel.is_set():
        return {'exit_code': 2, 'stdout': '', 'stderr': 'Scanner cancelled\n'}
    env = dict(os.environ, UBS_NO_AUTO_UPDATE='1', NO_COLOR='1')
    command = [str(scanner), *options, '--', *map(str, paths)]
    process = subprocess.Popen(command, cwd=root, env=env, stdout=subprocess.PIPE,
                               stderr=subprocess.PIPE, start_new_session=True, bufsize=0)
    deadline = time.monotonic() + timeout
    output = {'stdout': bytearray(), 'stderr': bytearray()}
    error = None
    with selectors.DefaultSelector() as streams:
        try:
            for name in output:
                pipe = getattr(process, name)
                os.set_blocking(pipe.fileno(), False)
                streams.register(pipe, selectors.EVENT_READ, name)
            while streams.get_map() or process.poll() is None:
                if cancel is not None and cancel.is_set():
                    error = 'Scanner cancelled'
                    break
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    error = 'Scanner timed out'
                    break
                for key, _ in streams.select(min(0.05, remaining)):
                    buffer = output[key.data]
                    try:
                        chunk = os.read(key.fd, min(65536, MAX_OUTPUT - len(buffer) + 1))
                    except BlockingIOError:
                        continue
                    if not chunk:
                        streams.unregister(key.fileobj)
                    elif len(buffer) + len(chunk) > MAX_OUTPUT:
                        error = 'Scanner output exceeded service limit'
                        break
                    else:
                        buffer.extend(chunk)
                if error:
                    break
        finally:
            # Even successful runners can leave helpers with closed stdio.
            # This group belongs solely to this request, not to the caller.
            try:
                os.killpg(process.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            process.wait()
            process.stdout.close()
            process.stderr.close()
    if error:
        return {'exit_code': 2, 'stdout': '', 'stderr': error + '\n'}
    return {'exit_code': process.returncode if process.returncode >= 0 else 128 - process.returncode,
            **{name: data.decode('utf-8', 'replace') for name, data in output.items()}}


class _Cancellation:
    """Combine service shutdown and one client's cancellation without a monitor thread."""

    def __init__(self, *events):
        self.events = tuple(event for event in events if event is not None)

    def is_set(self):
        return any(event.is_set() for event in self.events)


class ScanService:
    def __init__(self, root: Path, scanner: Path, timeout: float, cache_bytes: int, jobs: int = 1):
        self.root, self.scanner = root, scanner
        self.root_identity = identity(root)
        self.environment = environment_key()
        self.timeout, self.cache_bytes = timeout, cache_bytes
        self.cache = OrderedDict()
        self.cache_size = 0
        self.jobs = jobs
        self._stop = threading.Event()
        self._cache_lock = threading.Lock()

    @property
    def stopping(self):
        return self._stop.is_set()

    @stopping.setter
    def stopping(self, value):
        if value:
            self._stop.set()

    def stop(self):
        self._stop.set()

    def check_root(self):
        try:
            unchanged = identity(self.root) == self.root_identity
        except OSError:
            unchanged = False
        if not unchanged:
            self.stop()
            raise ServiceError('Served repository root has been replaced')

    def handle(self, request: dict, *, cancel: threading.Event | None = None) -> dict:
        if type(request.get('protocol')) is not int or request['protocol'] != PROTOCOL or request.get('root') != str(self.root):
            raise ServiceError('Protocol or repository mismatch')
        self.check_root()
        op = request.get('op')
        if not isinstance(op, str):
            raise ServiceError('Invalid service operation')
        if op in {'status', 'stop'}:
            if set(request) - {'protocol', 'op', 'root'}:
                raise ServiceError('Unknown lifecycle request fields')
            if op == 'stop':
                self.stop()
            return {'protocol': PROTOCOL, 'root': str(self.root), 'pid': os.getpid(), 'status': 'stopping' if self.stopping else 'ready'}
        if op != 'scan':
            raise ServiceError('Unknown service operation')
        cancellation = _Cancellation(self._stop, cancel)
        cancelled = cancellation.is_set
        if cancelled():
            raise ServiceError('Scanner request cancelled')
        paths, options = validate_scan(self.root, request)
        if request.get('environment') != self.environment or request.get('scanner') != str(self.scanner):
            return {'protocol': PROTOCOL, 'unavailable': 'Invocation environment or scanner differs from the daemon'}
        started = time.monotonic()
        # The Python text producer can include live dependency-audit results.
        # Its external environment/advisory database is not a source snapshot;
        # reuse only when callers explicitly disable those optional tools.
        live_audit = request.get('format', 'json') == 'text' and os.environ.get('ENABLE_UV_TOOLS') != '0' \
            and any(path.is_dir() or path.suffix.lower() in {'.py', '.pyi', '.pyw', '.ipynb'} for path in paths)
        # Project scans can run optional tools/build phases; Git selection
        # also depends on objects/metadata outside snapshot(). Those results
        # are not source-only. Keep the scanner's own incremental cache, but
        # do not reuse whole reports or silently disable the caller's tools.
        source_only = request.get('selection', 'files') == 'files'
        reuse = self.cache_bytes and not live_audit and source_only
        before = snapshot(self.root, self.scanner, cancel=cancellation) if reuse else None
        check_cancelled(cancellation)
        key = (tuple(map(str, paths)), tuple(options), before)
        with self._cache_lock:
            cached = self.cache.pop(key, None) if before is not None else None
            if cached is not None:
                self.cache[key] = cached
        if cached is not None:
            result = dict(cached[0], cached=True)
        else:
            result = run_scanner(self.root, self.scanner, paths, options, self.timeout,
                                 cancel=cancellation)
            check_cancelled(cancellation)
            self.check_root()
            # Never cache environment failures or scans spanning a source edit.
            after = snapshot(self.root, self.scanner, cancel=cancellation) if before is not None else None
            check_cancelled(cancellation)
            result['cached'] = False
            if before is not None and before == after and result['exit_code'] in (0, 1) and not cancelled():
                size = len(json.dumps(result).encode())
                with self._cache_lock:
                    previous = self.cache.pop(key, None)
                    if previous is not None:
                        self.cache_size -= previous[1]
                    while self.cache and self.cache_size + size > self.cache_bytes:
                        _, (_, removed) = self.cache.popitem(last=False)
                        self.cache_size -= removed
                    if size <= self.cache_bytes:
                        self.cache[key] = (result.copy(), size)
                        self.cache_size += size
        if cancelled():
            raise ServiceError('Scanner request cancelled')
        return dict(result, protocol=PROTOCOL, elapsed_ms=round((time.monotonic() - started) * 1000, 3))


class ServiceConnection:
    """One bounded request/response; only the selector thread owns I/O state."""
    def __init__(self, connection: socket.socket):
        self.socket = connection
        self.phase = 'read'
        self.deadline = time.monotonic() + IO_TIMEOUT
        self.input = bytearray()
        self.expected = 4
        self.request = None
        self.output = b''
        self.sent = 0
        self.scan = False
        self.cancel = threading.Event()
        self.scan_key = None
        self.request_id = None


def serve_connections(service: ScanService, listener: socket.socket, idle_timeout: float) -> None:
    """Bound scan concurrency and retain at most one reply per configured worker.

    Lifecycle and framing stay on the selector thread. Identical requests are
    serialized, not blindly given another client's result: each waiter still
    validates its inputs and the complete cache snapshot when it starts.
    """
    peers = set()
    pending = deque()
    active = {}
    last_request = time.monotonic()
    listener.setblocking(False)
    executor = ThreadPoolExecutor(max_workers=service.jobs, thread_name_prefix='ubs-scan')
    with selectors.DefaultSelector() as selector:
        selector.register(listener, selectors.EVENT_READ)

        def close(peer):
            peer.cancel.set()
            try:
                selector.unregister(peer.socket)
            except KeyError:
                pass
            peer.socket.close()
            peers.discard(peer)

        def reply(peer, value):
            try:
                peer.output = value if isinstance(value, bytes) else encode_message(value)
            except (ServiceError, ValueError) as exc:
                peer.output = encode_message(failure(str(exc)))
            peer.input.clear()
            peer.request = None
            peer.phase = 'write'
            peer.sent = 0
            peer.deadline = time.monotonic() + IO_TIMEOUT
            try:
                selector.modify(peer.socket, selectors.EVENT_WRITE, peer)
            except KeyError:
                selector.register(peer.socket, selectors.EVENT_WRITE, peer)

        def scan(peer):
            try:
                return encode_message(service.handle(peer.request, cancel=peer.cancel))
            except Exception as exc:
                # A failed worker must never strand the connection or produce
                # a clean report. Keep the control plane available for stop.
                return encode_message(failure(str(exc)))

        try:
            while True:
                now = time.monotonic()
                if service.stopping:
                    try:
                        selector.unregister(listener)
                    except KeyError:
                        pass
                    for peer in active:
                        peer.cancel.set()
                    for peer in list(peers):
                        if peer.phase in {'read', 'queued'}:
                            peer.cancel.set()
                            reply(peer, failure('Scanner cancelled: service is stopping'))
                for peer, future in list(active.items()):
                    if future.done():
                        del active[peer]
                        if peer in peers and peer.phase == 'running':
                            reply(peer, failure('Scanner cancelled by request') if peer.cancel.is_set() else future.result())
                        last_request = now
                for peer in list(peers):
                    if now >= peer.deadline:
                        if peer.phase == 'write':
                            close(peer)
                        else:
                            peer.cancel.set()
                            message = 'Scanner queue wait exceeded service limit' if peer.phase == 'queued' \
                                else 'Service request timed out'
                            reply(peer, failure(message))
                pending = deque(peer for peer in pending if peer in peers and peer.phase == 'queued')
                # Count undelivered replies as worker reservations. A stalled
                # reader cannot accumulate unbounded reports by cycling jobs.
                occupied = len(active) + sum(peer.scan and peer.phase == 'write' for peer in peers)
                busy_keys = {peer.scan_key for peer in active}
                for _ in range(len(pending)):
                    if service.stopping or occupied >= service.jobs:
                        break
                    peer = pending.popleft()
                    if peer.scan_key in busy_keys:
                        pending.append(peer)
                        continue
                    peer.phase = 'running'
                    peer.deadline = float('inf')
                    active[peer] = executor.submit(scan, peer)
                    occupied += 1
                    busy_keys.add(peer.scan_key)
                if not peers and not active:
                    if service.stopping or now - last_request >= idle_timeout:
                        break
                for key, _ in selector.select(min(0.05, idle_timeout)):
                    if key.fileobj is listener:
                        if service.stopping:
                            continue
                        try:
                            connection, _ = listener.accept()
                        except BlockingIOError:
                            continue
                        connection.setblocking(False)
                        try:
                            if peer_uid(connection) != os.getuid():
                                raise ServiceError('Peer uid does not match daemon uid')
                            if len(peers) >= MAX_CLIENTS:
                                raise ServiceError('Service connection limit reached')
                        except (ServiceError, OSError) as exc:
                            try:
                                connection.send(encode_message(failure(str(exc))))
                            except OSError:
                                pass
                            connection.close()
                            continue
                        peer = ServiceConnection(connection)
                        peers.add(peer)
                        selector.register(connection, selectors.EVENT_READ, peer)
                        continue
                    peer = key.data
                    if peer not in peers:
                        continue
                    try:
                        if peer.phase == 'write':
                            sent = peer.socket.send(memoryview(peer.output)[peer.sent:peer.sent + 65536])
                            if not sent:
                                close(peer)
                                continue
                            peer.sent += sent
                            if peer.sent == len(peer.output):
                                close(peer)
                            continue
                        if peer.phase in {'queued', 'running'}:
                            if peer.socket.recv(1):
                                peer.cancel.set()
                                raise ServiceError('Only one request is allowed per connection')
                            # Preserve the established write-half-close contract.
                            selector.unregister(peer.socket)
                            continue
                        chunk = peer.socket.recv(min(65536, peer.expected - len(peer.input)))
                        if not chunk:
                            raise ServiceError('Incomplete service message')
                        peer.input.extend(chunk)
                        if len(peer.input) != peer.expected:
                            continue
                        if peer.expected == 4:
                            size = struct.unpack('!I', peer.input)[0]
                            if size == 0 or size > MAX_REQUEST:
                                raise ServiceError('Service message exceeds the permitted size')
                            peer.expected += size
                            continue
                        request = decode_message(peer.input[4:])
                        peer.input.clear()
                        last_request = time.monotonic()
                        if request.get('op') == 'scan' and not service.stopping:
                            if sum(client.scan for client in peers) >= MAX_PENDING_SCANS:
                                raise ServiceError('Scanner queue is full; retry later')
                            if 'request_id' in request:
                                request_id = validate_request_id(request['request_id'])
                                if any(client.request_id == request_id for client in peers | set(active)):
                                    raise ServiceError('Request id is already in use')
                                peer.request_id = request_id
                            peer.scan = True
                            peer.request = request
                            # Scheduling only: this key never authorizes reuse.
                            # Canonical validation and byte snapshots remain in
                            # the worker so queued edits are seen when it runs.
                            peer.scan_key = json.dumps({key: value for key, value in request.items() if key != 'request_id'},
                                                       sort_keys=True, separators=(',', ':'))
                            peer.phase = 'queued'
                            peer.deadline = time.monotonic() + QUEUE_TIMEOUT
                            pending.append(peer)
                        elif request.get('op') == 'cancel':
                            # Authenticate the usual protocol/root before any
                            # state mutation, even though the target owns its
                            # own scan environment and policy.
                            if set(request) != {'protocol', 'op', 'root', 'request_id'}:
                                raise ServiceError('Invalid cancellation request fields')
                            service.handle({key: value for key, value in request.items() if key != 'request_id'} | {'op': 'status'})
                            request_id = validate_request_id(request['request_id'])
                            target = next((client for client in peers if client.request_id == request_id), None)
                            if target is None or target.phase not in {'queued', 'running'}:
                                reply(peer, dict(failure('No cancellable request has that id'),
                                                 error='request_not_active'))
                                continue
                            if target in active and active[target].done():
                                reply(peer, dict(failure('Request has already completed'),
                                                 error='request_not_active'))
                                continue
                            target.cancel.set()
                            if target.phase == 'queued':
                                reply(target, failure('Scanner cancelled by request'))
                            reply(peer, {'protocol': PROTOCOL, 'root': str(service.root),
                                         'status': 'cancelling', 'request_id': request_id})
                        else:
                            response = service.handle(request)
                            if request.get('op') == 'status':
                                response.update(active_scans=len(active), queued_scans=len(pending),
                                                max_scans=service.jobs)
                            reply(peer, response)
                    except BlockingIOError:
                        continue
                    except (ServiceError, ValueError) as exc:
                        reply(peer, failure(str(exc)))
                    except OSError:
                        close(peer)
        finally:
            service.stop()
            for peer in active:
                peer.cancel.set()
            for peer in list(peers):
                close(peer)
            executor.shutdown(wait=True, cancel_futures=True)


def serve(service: ScanService, idle_timeout: float) -> int:
    path = socket_path(service.root, create=True)
    lock_path = path.with_suffix('.lock')
    if lock_path.is_symlink():
        raise ServiceError('Refusing a symlinked service lock')
    flags = os.O_CREAT | os.O_RDWR | os.O_NONBLOCK | getattr(os, 'O_NOFOLLOW', 0)
    descriptor = os.open(lock_path, flags, 0o600)
    with os.fdopen(descriptor, 'r+b') as lock, socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as listener:
        info = os.fstat(lock.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
            raise ServiceError('Unsafe service lock')
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise ServiceError('A daemon already owns this repository') from exc
        if path.exists() or path.is_symlink():
            info = path.lstat()
            if not stat.S_ISSOCK(info.st_mode) or info.st_uid != os.getuid():
                raise ServiceError('Refusing to replace a non-socket or foreign service path')
            path.unlink()
        old_mask = os.umask(0o177)
        try:
            listener.bind(str(path))
        finally:
            os.umask(old_mask)
        socket_identity = identity(path)
        try:
            os.chmod(path, 0o600)
            listener.listen(16)
            serve_connections(service, listener, idle_timeout)
        finally:
            try:
                if identity(path) == socket_identity:
                    path.unlink()
            except FileNotFoundError:
                pass
    return 0


def request_service(root: Path, request: dict, timeout: float,
                    *, cancel: threading.Event | None = None) -> dict:
    """One bounded exchange with an absolute deadline and optional interruption."""
    check_cancelled(cancel)
    deadline = time.monotonic() + timeout
    path = socket_path(root)
    info = path.lstat()
    if not stat.S_ISSOCK(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
        raise ServiceError('Unsafe daemon socket')
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
        # AF_UNIX connection setup can wait behind a full listen backlog. It
        # has its own short cap; transfer below is interruptible in both phases.
        connection.settimeout(min(IO_TIMEOUT, timeout))
        connection.connect(str(path))
        if peer_uid(connection) != os.getuid():
            raise ServiceError('Server uid does not match client uid')
        connection.setblocking(False)
        outgoing = encode_message(request)
        sent = 0
        incoming = bytearray()
        expected = 4
        with selectors.DefaultSelector() as selector:
            selector.register(connection, selectors.EVENT_WRITE)
            while True:
                check_cancelled(cancel)
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    raise ServiceError('Service request timed out')
                if not selector.select(min(0.05, remaining)):
                    continue
                try:
                    if sent < len(outgoing):
                        count = connection.send(memoryview(outgoing)[sent:sent + 65536])
                        if not count:
                            raise ServiceError('Incomplete service request')
                        sent += count
                        if sent == len(outgoing):
                            selector.modify(connection, selectors.EVENT_READ)
                        continue
                    chunk = connection.recv(min(65536, expected - len(incoming)))
                    if not chunk:
                        raise ServiceError('Incomplete service message')
                    incoming.extend(chunk)
                    if len(incoming) != expected:
                        continue
                    if expected == 4:
                        size = struct.unpack('!I', incoming)[0]
                        if size == 0 or size > MAX_RESPONSE:
                            raise ServiceError('Service message exceeds the permitted size')
                        expected += size
                    else:
                        break
                except BlockingIOError:
                    continue
        response = decode_message(incoming[4:])
        if type(response.get('protocol')) is not int or response['protocol'] != PROTOCOL:
            raise ServiceError('Unsupported service response')
        return response


def validate_scan_response(response: dict) -> None:
    if 'unavailable' in response:
        raise ServiceError(str(response['unavailable']))
    if type(response.get('exit_code')) is not int or not 0 <= response['exit_code'] <= 255:
        raise ServiceError('Invalid scanner exit status')
    if not isinstance(response.get('stdout'), str) or not isinstance(response.get('stderr'), str):
        raise ServiceError('Invalid scanner output streams')


def watch_inputs(root: Path, names: list[str]) -> tuple[str, list[str]]:
    """Byte-hash explicitly watched files; missing/unsafe states are never clean.

    This is an edit trigger, not permission to reuse scanner results. Include
    inode/ctime as well as bytes to catch atomic saves and an edit restored
    between observations. Inputs outside this list are not watched.
    """
    digest = hashlib.sha256()
    errors = []
    total = 0
    for name in names:
        path = root / name
        digest.update(os.fsencode(name) + b'\0')
        try:
            resolved = path.resolve(strict=True)
            if not resolved.is_relative_to(root):
                raise ServiceError('watched path is outside the served repository')
            digest.update(os.fsencode(str(resolved)) + b'\0')
            # Nonblocking prevents a file changed to a FIFO from hanging the
            # watch loop. Verify the opened descriptor, not an earlier stat.
            flags = os.O_RDONLY | os.O_NONBLOCK | getattr(os, 'O_NOFOLLOW', 0)
            descriptor = os.open(resolved, flags)
            with os.fdopen(descriptor, 'rb') as stream:
                before = os.fstat(stream.fileno())
                stamp = (before.st_dev, before.st_ino, before.st_mode, before.st_size,
                         before.st_mtime_ns, before.st_ctime_ns)
                digest.update(repr(stamp).encode() + b'\0')
                if not stat.S_ISREG(before.st_mode):
                    raise ServiceError('watched source is not a regular file')
                if before.st_size > MAX_SNAPSHOT - total:
                    raise ServiceError('watched sources exceed the byte limit')
                while chunk := stream.read(65536):
                    total += len(chunk)
                    if total > MAX_SNAPSHOT:
                        raise ServiceError('watched sources exceed the byte limit')
                    digest.update(chunk)
                after = os.fstat(stream.fileno())
                current = path.stat()
                if path.resolve(strict=True) != resolved or any(
                    (item.st_dev, item.st_ino, item.st_mode, item.st_size, item.st_mtime_ns, item.st_ctime_ns) != stamp
                    for item in (after, current)
                ):
                    raise ServiceError('watched source changed while being read')
        except (OSError, ServiceError, ValueError, RuntimeError) as exc:
            message = f'{name}: {exc}'
            errors.append(message)
            digest.update(b'error\0' + message.encode('utf-8', 'replace'))
        digest.update(b'\0')
    return 'sha256:' + digest.hexdigest(), errors


def cancel_watch_request(root: Path, request_id: str) -> bool:
    response = request_service(root, {'protocol': PROTOCOL, 'op': 'cancel',
                                     'root': str(root), 'request_id': request_id}, IO_TIMEOUT)
    # A source change can race with admission or completion. Retry only this
    # typed condition; other authentication/protocol failures remain errors.
    if response.get('exit_code') == 2 and response.get('error') == 'request_not_active':
        return False
    if response.get('root') != str(root) or response.get('status') != 'cancelling' \
            or response.get('request_id') != request_id:
        raise ServiceError('Could not cancel obsolete watch scan: ' + str(response.get('stderr', 'invalid reply')))
    return True


def watch(root: Path, request: dict, timeout: float, interval: float, debounce: float) -> int:
    """Foreground, explicit-file edit feedback; never starts a daemon or falls back."""
    validate_scan(root, request)
    if request.get('selection', 'files') != 'files':
        raise ServiceError('watch requires explicit source files, not directory or Git selection')
    root_identity = identity(root)
    status = request_service(root, {'protocol': PROTOCOL, 'op': 'status', 'root': str(root)}, IO_TIMEOUT)
    if status.get('root') != str(root) or status.get('status') != 'ready':
        raise ServiceError('watch requires a ready daemon')
    executor = ThreadPoolExecutor(max_workers=1, thread_name_prefix='ubs-watch')
    abort = threading.Event()
    future = None
    request_id = None
    generation = 0
    observed = None
    active_generation = None
    cancelled = False
    pending = False
    settled_at = 0.0
    names = request['paths']

    def emit(event, **fields):
        print(json.dumps(dict(schema='ubs.watch/1', event=event, generation=generation,
                              source_fingerprint=observed, paths=names, **fields),
                         ensure_ascii=True, separators=(',', ':')), flush=True)

    try:
        while True:
            if identity(root) != root_identity:
                raise ServiceError('Watched repository root has been replaced')
            stamp, errors = watch_inputs(root, names)
            now = time.monotonic()
            if stamp != observed:
                observed = stamp
                generation += 1
                pending = True
                settled_at = now + debounce
                # Consumers must immediately invalidate the previous result,
                # even while the next generation is still settling/scanning.
                emit('changed')
            if future is not None:
                if active_generation != generation and not future.done() and not cancelled:
                    cancelled = cancel_watch_request(root, request_id)
                if future.done():
                    completed, future = future, None
                    response = completed.result()
                    # Completion and observation can race. Re-read immediately
                    # before publishing; never attach a prior generation's
                    # report to bytes saved while the exchange was finishing.
                    final_stamp, errors = watch_inputs(root, names)
                    if final_stamp != observed:
                        observed = final_stamp
                        generation += 1
                        pending = True
                        settled_at = time.monotonic() + debounce
                        emit('changed')
                    if active_generation != generation:
                        emit('superseded', superseded_generation=active_generation)
                    else:
                        validate_scan_response(response)
                        emit('result', **{key: response[key] for key in ('exit_code', 'stdout', 'stderr')},
                             cached=bool(response.get('cached', False)))
                    request_id = None
            if future is None and pending and now >= settled_at:
                pending = False
                if errors:
                    emit('invalid', exit_code=2, stdout='', stderr='\n'.join(errors) + '\n')
                else:
                    request_id = 'watch-' + uuid.uuid4().hex
                    active_generation = generation
                    cancelled = False
                    future = executor.submit(request_service, root, dict(request, request_id=request_id),
                                             timeout + 10, cancel=abort)
                    emit('scanning', request_id=request_id)
            time.sleep(interval)
    except (ServiceError, OSError, ValueError) as exc:
        emit('error', exit_code=2, stdout='', stderr=str(exc) + '\n')
        return 2
    finally:
        try:
            if request_id is not None:
                # Allow for a just-submitted request not yet being admitted.
                # A finished transport future can also mean timeout, not a
                # finished scanner; still cancel that remote request once.
                until = time.monotonic() + IO_TIMEOUT
                while time.monotonic() < until:
                    if cancel_watch_request(root, request_id):
                        break
                    if future is None or future.done():
                        break
                    time.sleep(0.05)
        except (ServiceError, OSError, ValueError) as exc:
            print(f'ubs-daemon: watch cancellation failed: {exc}', file=sys.stderr)
        finally:
            abort.set()
            executor.shutdown(wait=True, cancel_futures=True)


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('command', choices=('serve', 'client', 'watch', 'status', 'stop', 'cancel'))
    parser.add_argument('files', nargs='*', help='source files or one directory relative to --repo')
    parser.add_argument('--repo', default='.', help='repository root (default: current directory)')
    parser.add_argument('--scanner', default=str(Path(__file__).resolve().with_name('ubs')))
    parser.add_argument('--format', default='json', choices=sorted(FORMATS))
    parser.add_argument('--profile', choices=('strict', 'loose'))
    parser.add_argument('--fail-on-warning', action='store_true')
    parser.add_argument('--require-daemon', action='store_true', help='do not fall back to one-shot scanning')
    parser.add_argument('--idle-timeout', type=float, default=900)
    parser.add_argument('--scan-timeout', type=float, default=120)
    parser.add_argument('--cache-mib', type=int, default=32, help='bounded report cache; 0 disables reuse')
    parser.add_argument('--jobs', type=int, default=1, help='concurrent scanner processes for serve (1 to 8)')
    parser.add_argument('--request-id', help='name a client request or identify one to cancel')
    parser.add_argument('--watch-interval', type=float, default=None, help='watch poll interval in seconds (0.1 to 60)')
    parser.add_argument('--debounce', type=float, default=None, help='watch quiet period in seconds (0 to 60)')
    selection = parser.add_mutually_exclusive_group()
    selection.add_argument('--staged', action='store_true', help='scan Git index contents, not worktree copies')
    selection.add_argument('--diff', action='store_true', help='scan worktree changes using the normal runner')
    args = parser.parse_intermixed_args(argv)
    try:
        if os.name != 'posix' or fcntl is None:
            raise ServiceError('The local scan service requires a POSIX Unix-socket platform')
        if not 0 < args.idle_timeout <= 86400 or not 0 < args.scan_timeout <= 3600 or not 0 <= args.cache_mib <= 256:
            raise ServiceError('Timeouts/cache size are outside permitted bounds')
        if not 1 <= args.jobs <= 8 or (args.command != 'serve' and args.jobs != 1):
            raise ServiceError('--jobs applies to serve and must be between 1 and 8')
        if args.request_id is not None:
            validate_request_id(args.request_id)
            if args.command not in {'client', 'cancel'}:
                raise ServiceError('--request-id applies only to client and cancel')
        if args.command == 'cancel' and args.request_id is None:
            raise ServiceError('cancel requires --request-id')
        if args.command != 'watch' and (args.watch_interval is not None or args.debounce is not None):
            raise ServiceError('--watch-interval and --debounce apply only to watch')
        interval = args.watch_interval if args.watch_interval is not None else 0.25
        debounce = args.debounce if args.debounce is not None else 0.3
        if not 0.1 <= interval <= 60 or not 0 <= debounce <= 60:
            raise ServiceError('Watch interval/debounce is outside permitted bounds')
        if args.command not in {'client', 'watch'} and (args.profile is not None or args.fail_on_warning
                                         or args.require_daemon or args.format != 'json' or args.staged or args.diff):
            raise ServiceError('Scan policy and report options apply to client requests, not service lifecycle commands')
        root = Path(args.repo).resolve(strict=True)
        scanner = Path(args.scanner).resolve(strict=True)
        if not root.is_dir() or not scanner.is_file() or not os.access(scanner, os.X_OK):
            raise ServiceError('Repository must be a directory and scanner must be executable')
        if args.command == 'serve':
            if args.files:
                raise ServiceError('serve does not accept source files')
            service = ScanService(root, scanner, args.scan_timeout, args.cache_mib * 1024 * 1024, args.jobs)
            def stop(_signal, _frame):
                raise KeyboardInterrupt
            signal.signal(signal.SIGTERM, stop)
            return serve(service, args.idle_timeout)
        request = {'protocol': PROTOCOL, 'op': 'scan' if args.command in {'client', 'watch'} else args.command, 'root': str(root)}
        if args.request_id is not None:
            request['request_id'] = args.request_id
        if args.command in {'client', 'watch'}:
            request.update(paths=args.files, format=args.format, profile=args.profile, fail_on_warning=args.fail_on_warning,
                           environment=environment_key(), scanner=str(scanner))
            if args.staged or args.diff:
                request['selection'] = 'staged' if args.staged else 'diff'
            elif len(args.files) == 1 and (root / args.files[0]).is_dir():
                request['selection'] = 'directory'
            paths, options = validate_scan(root, request)
            if args.command == 'watch':
                def stop_watch(_signal, _frame):
                    raise KeyboardInterrupt
                signal.signal(signal.SIGTERM, stop_watch)
                return watch(root, request, args.scan_timeout, interval, debounce)
        elif args.files:
            raise ServiceError('Lifecycle commands do not accept source files')
        try:
            response = request_service(root, request, args.scan_timeout + 10)
        except OSError as exc:
            if exc.errno not in (errno.ENOENT, errno.ECONNREFUSED):
                raise
            response = {'unavailable': 'No daemon is running'}
        if 'unavailable' in response:
            if args.command != 'client' or args.require_daemon:
                raise ServiceError(response['unavailable'])
            response = run_scanner(root, scanner, paths, options, args.scan_timeout)
        if 'exit_code' in response:
            validate_scan_response(response)
            sys.stdout.write(response['stdout'])
            sys.stderr.write(response['stderr'])
            return response['exit_code']
        valid_status = {'cancelling'} if args.command == 'cancel' else {'ready', 'stopping'}
        if args.command == 'client' or response.get('root') != str(root) or response.get('status') not in valid_status:
            raise ServiceError('Incomplete service response; no scan result is available')
        if args.command == 'cancel' and response.get('request_id') != args.request_id:
            raise ServiceError('Cancellation response does not identify the requested scan')
        print(json.dumps(response))
        return 0
    except (ServiceError, OSError, ValueError) as exc:
        print(f'ubs-daemon: {exc}', file=sys.stderr)
        return 2
    except KeyboardInterrupt:
        return 130


if __name__ == '__main__':
    raise SystemExit(main())
