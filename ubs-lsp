#!/usr/bin/env python3
"""UBS editor diagnostics over LSP; saved source or opt-in buffer snapshots.

Run from a trusted checkout with an explicit --repo. Buffer snapshots never
write into the original workspace. Detection remains in the ordinary trusted
UBS runner; this adapter is neither a second detector nor an execution sandbox.
"""
from __future__ import annotations

import argparse
from collections import OrderedDict, deque
from concurrent.futures import ThreadPoolExecutor
import hashlib
import json
import os
from pathlib import Path
import re
import selectors
import signal
import stat
import subprocess
import sys
import threading
import tempfile
import time
from urllib.parse import unquote_to_bytes, urlsplit

MAX_MESSAGE = 8 * 1024 * 1024
MAX_TEXT = 2 * 1024 * 1024
MAX_TEXT_TOTAL = 16 * 1024 * 1024
MAX_DOCUMENTS = 64
MAX_OUTPUT = 8 * 1024 * 1024
MAX_DIAGNOSTICS = 2000


class ProtocolError(ValueError):
    pass


def decode_json(data):
    def constant(value):
        raise ProtocolError('Non-finite JSON number: ' + value)
    def pairs(items):
        result = {}
        for key, value in items:
            if key in result:
                raise ProtocolError('Duplicate JSON field: ' + key)
            result[key] = value
        return result
    try:
        return json.loads(data, parse_constant=constant, object_pairs_hook=pairs)
    except (ValueError, UnicodeError, RecursionError) as exc:
        raise ProtocolError('Invalid JSON: ' + str(exc)) from exc


def frame(message):
    body = json.dumps(message, ensure_ascii=True, separators=(',', ':')).encode('ascii')
    if len(body) > MAX_MESSAGE:
        raise ProtocolError('Outbound LSP message exceeds limit')
    return b'Content-Length: ' + str(len(body)).encode() + b'\r\n\r\n' + body


class Framer:
    def __init__(self):
        self.buffer = bytearray()
        self.expected = None

    def feed(self, data):
        # The stdio loop supplies at most 64 KiB at a time.
        if len(data) > MAX_MESSAGE + 8192:
            raise ProtocolError('Inbound LSP chunk exceeds limit')
        self.buffer.extend(data)
        while True:
            if self.expected is None:
                end = self.buffer.find(b'\r\n\r\n')
                if end < 0:
                    if len(self.buffer) > 8192:
                        raise ProtocolError('LSP headers exceed limit')
                    return
                if end > 8192:
                    raise ProtocolError('LSP headers exceed limit')
                headers = {}
                for line in bytes(self.buffer[:end]).split(b'\r\n'):
                    key, separator, value = line.partition(b':')
                    key, value = key.strip().lower(), value.strip()
                    if not separator or not key or key in headers:
                        raise ProtocolError('Invalid or duplicate LSP header')
                    headers[key] = value
                length = headers.get(b'content-length', b'')
                if not length.isdigit() or len(length) > 9 or not 0 < int(length) <= MAX_MESSAGE:
                    raise ProtocolError('Invalid LSP Content-Length')
                content_type = headers.get(b'content-type', b'').lower()
                if b'charset=' in content_type and content_type.split(b'charset=', 1)[1].strip() not in (b'utf-8', b'utf8'):
                    raise ProtocolError('LSP requires UTF-8')
                self.expected = int(length)
                del self.buffer[:end + 4]
            if len(self.buffer) < self.expected:
                return
            raw = bytes(self.buffer[:self.expected])
            del self.buffer[:self.expected]
            self.expected = None
            yield decode_json(raw)


def document_path(uri, root):
    if not isinstance(uri, str) or re.search(r'%(?![0-9a-fA-F]{2})', uri):
        raise ProtocolError('Invalid document URI')
    parsed = urlsplit(uri)
    if parsed.scheme != 'file' or parsed.netloc not in ('', 'localhost') or parsed.query or parsed.fragment:
        raise ProtocolError('Only local file URIs are supported')
    name = unquote_to_bytes(parsed.path).decode('utf-8')
    if '\0' in name or not name.startswith('/'):
        raise ProtocolError('Invalid file URI path')
    path = Path(os.path.normpath(name))
    if not path.is_relative_to(root) or path == root:
        raise ProtocolError('Document is outside the configured repository')
    return path


def normalized_text(value):
    if not isinstance(value, str) or len(value.encode('utf-8')) > MAX_TEXT:
        raise ProtocolError('Document text exceeds limit or is not UTF-8 text')
    return value.removeprefix('\ufeff').replace('\r\n', '\n').replace('\r', '\n')



def editor_text(value):
    """Keep wire text exact: normalization before range edits shifts positions."""
    normalized_text(value)  # Shared UTF-8/type/size validation, not its result.
    return value


def position_offset(text, position):
    """Translate a negotiated UTF-16 LSP position into an exact Python offset."""
    if not isinstance(position, dict) or any(type(position.get(key)) is not int
                                           or not 0 <= position[key] <= 2**31 - 1
                                           for key in ('line', 'character')):
        raise ProtocolError('Invalid UTF-16 edit position')
    line, character = position['line'], position['character']
    start = 0
    # LSP lines end only at CR/LF, not every Unicode separator splitlines uses.
    if line:
        for number, match in enumerate(re.finditer(r'\r\n|\r|\n', text), 1):
            if number == line:
                start = match.end()
                break
        else:
            raise ProtocolError('Edit line is outside the synchronized document')
    end = start
    units = 0
    while end < len(text) and text[end] not in '\r\n':
        if units == character:
            return end
        width = 2 if ord(text[end]) > 0xFFFF else 1
        if units + width > character:
            raise ProtocolError('Edit position splits a UTF-16 surrogate pair')
        units += width
        end += 1
    # The protocol clamps a character beyond line end, without entering CRLF.
    return end


def apply_changes(text, changes, *, synchronized=True):
    """Apply sequential changes transactionally, retaining BOM and newline bytes.

    A full replacement is required before any delta after synchronization loss.
    Bound the number of edits and intermediate documents, not just the final one.
    """
    if not isinstance(changes, list) or not 1 <= len(changes) <= 1024:
        raise ProtocolError('A change requires 1 to 1024 text updates')
    work = 0
    for change in changes:
        if not isinstance(change, dict):
            raise ProtocolError('Invalid document change')
        replacement = editor_text(change.get('text'))
        work += len(text) + len(replacement)
        if work > 2 * MAX_TEXT_TOTAL:
            raise ProtocolError('Document change work limit exceeded; send a full replacement')
        if 'range' not in change:
            if 'rangeLength' in change:
                raise ProtocolError('rangeLength requires an edit range')
            text, synchronized = replacement, True
            continue
        if not synchronized:
            raise ProtocolError('A full document change is required after a synchronization error')
        range_ = change['range']
        if not isinstance(range_, dict):
            raise ProtocolError('Invalid document edit range')
        start = position_offset(text, range_.get('start'))
        end = position_offset(text, range_.get('end'))
        if end < start or (range_['start']['line'], range_['start']['character']) > (range_['end']['line'], range_['end']['character']):
            raise ProtocolError('Reversed document edit range')
        length = change.get('rangeLength')
        if 'rangeLength' in change and (type(length) is not int or length < 0
                                        or length != len(text[start:end].encode('utf-16-le')) // 2):
            raise ProtocolError('Edit rangeLength disagrees with synchronized text')
        text = editor_text(text[:start] + replacement + text[end:])
    return text



def read_source(root, path, root_id):
    """Read a bounded regular file through no-follow directory descriptors."""
    directory = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        info = os.fstat(directory)
        if (info.st_dev, info.st_ino) != root_id:
            raise ProtocolError('Repository root was replaced')
        parts = path.relative_to(root).parts
        if not parts:
            raise ProtocolError('Source must be a file')
        for part in parts[:-1]:
            child = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=directory)
            os.close(directory)
            directory = child
        descriptor = os.open(parts[-1], os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW, dir_fd=directory)
        with os.fdopen(descriptor, 'rb') as stream:
            def stamp(value):
                return (value.st_dev, value.st_ino, value.st_mode, value.st_size,
                        value.st_mtime_ns, value.st_ctime_ns)
            before = os.fstat(stream.fileno())
            if not stat.S_ISREG(before.st_mode) or before.st_size > MAX_TEXT:
                raise ProtocolError('Source is not a bounded regular file')
            raw = stream.read(MAX_TEXT + 1)
            current = os.stat(parts[-1], dir_fd=directory, follow_symlinks=False)
            if len(raw) > MAX_TEXT or stamp(before) != stamp(os.fstat(stream.fileno())) or stamp(before) != stamp(current):
                raise ProtocolError('Source changed while being read')
            return normalized_text(raw.decode('utf-8')), (stamp(before), hashlib.sha256(raw).digest())
    finally:
        os.close(directory)


def note(code, message, severity=2):
    return {'range': {'start': {'line': 0, 'character': 0}, 'end': {'line': 0, 'character': 0}},
            'severity': severity, 'code': code, 'source': 'ubs', 'message': message[:8192]}


def report_diagnostics(report, path, root, text, exit_code, *, selected_paths=()):
    if not isinstance(report, dict) or report.get('status') != 'ok' or report.get('failed_modules'):
        raise ProtocolError('Scanner returned an incomplete or failed report')
    totals = report.get('totals')
    if not isinstance(totals, dict) or type(totals.get('files')) is not int or totals['files'] < 1:
        raise ProtocolError('Scanner did not verify any source files')
    records = report.get('findings')
    ast_records = report.get('ast_findings', [])
    if not isinstance(records, list) or not isinstance(ast_records, list):
        raise ProtocolError('Scanner report has no valid findings ledger')
    # A summary cannot be called clean merely because its producer omitted
    # diagnostic records. Report-only AST evidence does not supply this credit.
    accounted = {'critical': 0, 'warning': 0, 'info': 0}
    for finding in records:
        if not isinstance(finding, dict):
            raise ProtocolError('Invalid finding record')
        if finding.get('suppressed') is True:
            continue
        weight = finding.get('count') if finding.get('scope') in ('project', 'project_aggregate') else 1
        if type(weight) is not int or weight < 0:
            raise ProtocolError('Invalid finding occurrence count')
        if finding.get('severity') in accounted:
            accounted[finding['severity']] += weight
    for severity, available in accounted.items():
        declared = totals.get(severity, 0)
        if type(declared) is not int or not 0 <= declared <= available:
            raise ProtocolError('Scanner summary is not covered by its findings ledger')
    bases = [root]
    project = report.get('project')
    if isinstance(project, str) and Path(project).is_absolute():
        candidate = Path(os.path.normpath(project))
        if candidate.is_relative_to(root):
            bases.append(candidate.parent if candidate == path else candidate)
    lines = text.split('\n')
    diagnostics = []
    diagnostic_bytes = 0
    omitted = 0
    other_documents = 0
    for finding in records + ast_records:
        if not isinstance(finding, dict) or type(finding.get('suppressed', False)) is not bool:
            raise ProtocolError('Invalid finding record')
        if finding.get('suppressed', False):
            continue
        rule, message = finding.get('rule_id'), finding.get('message')
        severity = finding.get('severity')
        if not isinstance(rule, str) or not rule or not isinstance(message, str) or severity not in ('critical', 'warning', 'info'):
            raise ProtocolError('Finding lacks rule, message or severity')
        level = {'critical': 1, 'warning': 2, 'info': 3}[severity]
        source = finding.get('file')
        line = finding.get('line')
        if finding.get('scope') in ('project', 'project_aggregate'):
            diagnostic = note(rule, '[Project-level finding] ' + message, level)
        else:
            if not isinstance(source, str) or not source or type(line) is not int or line < 1:
                raise ProtocolError('Finding has invalid source coordinates')
            if not any(Path(os.path.normpath(base / source)) == path for base in bases):
                if any(Path(os.path.normpath(base / source)) in selected_paths for base in bases):
                    other_documents += 1
                    continue
                omitted += 1
                continue
            if line > len(lines):
                raise ProtocolError('Finding is outside the saved document')
            content = lines[line - 1]
            # Producers do not share a proven column unit across languages.
            # Highlight the complete line rather than inventing byte/codepoint
            # precision. LSP ranges use UTF-16 code units, including astral text.
            end = len(content.encode('utf-16-le')) // 2
            diagnostic = {'range': {'start': {'line': line - 1, 'character': 0},
                                    'end': {'line': line - 1, 'character': end}},
                          'severity': level, 'code': rule, 'source': 'ubs', 'message': (message or rule)[:8192]}
        size = len(json.dumps(diagnostic, ensure_ascii=True).encode('ascii'))
        if len(diagnostics) < MAX_DIAGNOSTICS - 1 and diagnostic_bytes + size < MAX_MESSAGE // 2:
            diagnostics.append(diagnostic)
            diagnostic_bytes += size
        else:
            omitted += 1
    if omitted:
        diagnostics.append(note('ubs.incomplete-display', f'{omitted} additional findings are outside this document or the display limit. Run UBS to see the complete report.'))
    if exit_code == 1 and not diagnostics and not other_documents:
        diagnostics.append(note('ubs.unlocated-findings', 'UBS reported a failing scan without visible source diagnostics. Run UBS for the complete report.'))
    return diagnostics


def scan(scanner, root, documents, root_id, timeout, cancel, policy=()):
    snapshots = {}
    unsaved = []
    for uri, doc in documents.items():
        if cancel.is_set():
            raise ProtocolError('Scan cancelled')
        saved, identity = read_source(root, doc['path'], root_id)
        snapshots[uri] = (saved, identity)
        if saved != doc['text'] or not doc['synchronized']:
            unsaved.append(uri)
    if unsaved:
        return {uri: ([note('ubs.unsaved' if uri in unsaved else 'ubs.unverified',
                           'Save and synchronize every selected document before running this scan.', 3)], None)
                for uri in documents}
    paths = tuple(dict.fromkeys(doc['path'] for doc in documents.values()))
    if len(paths) != len(documents):
        raise ProtocolError('Multiple editor URIs name the same source; close duplicate documents')
    if cancel.is_set():
        raise ProtocolError('Scan cancelled')
    command = [str(scanner), '--ci', '--no-auto-update', '--no-color', '--format=json', *policy, '--', *map(str, paths)]
    process = subprocess.Popen(command, cwd=root, env=dict(os.environ, UBS_NO_AUTO_UPDATE='1', NO_COLOR='1'),
                               stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                               start_new_session=True, bufsize=0)
    output = {'stdout': bytearray(), 'stderr': bytearray()}
    deadline = time.monotonic() + timeout
    try:
        with selectors.DefaultSelector() as pipes:
            for name in output:
                pipe = getattr(process, name)
                os.set_blocking(pipe.fileno(), False)
                pipes.register(pipe, selectors.EVENT_READ, name)
            while pipes.get_map() or process.poll() is None:
                if cancel.is_set():
                    raise ProtocolError('Scan cancelled')
                if time.monotonic() >= deadline:
                    raise ProtocolError('Scanner timed out')
                for key, _ in pipes.select(0.03):
                    buffer = output[key.data]
                    try:
                        chunk = os.read(key.fd, min(65536, MAX_OUTPUT - len(buffer) + 1))
                    except BlockingIOError:
                        continue
                    if not chunk:
                        pipes.unregister(key.fileobj)
                    elif len(buffer) + len(chunk) > MAX_OUTPUT:
                        raise ProtocolError('Scanner output exceeded limit')
                    else:
                        buffer.extend(chunk)
    finally:
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        process.wait()
        process.stdout.close()
        process.stderr.close()
    if cancel.is_set():
        raise ProtocolError('Scan cancelled')
    for uri, doc in documents.items():
        if read_source(root, doc['path'], root_id) != snapshots[uri]:
            raise ProtocolError('Selected source changed during the scan; save again to recheck')
    if process.returncode == 3:
        return {uri: ([note('ubs.not-scanned', 'UBS found no scan targets. This is not a verified clean document.')], value[1])
                for uri, value in snapshots.items()}
    if process.returncode not in (0, 1):
        detail = output['stderr'].decode('utf-8', 'replace')[-2048:]
        raise ProtocolError(f'Scanner failed (exit {process.returncode}): {detail}')
    report = decode_json(output['stdout'])
    if not isinstance(report, dict) or not isinstance(report.get('totals'), dict) or report['totals'].get('files') != len(paths):
        raise ProtocolError('Scanner coverage does not match selected documents; ignored or unsupported files are not verified')
    return {uri: (report_diagnostics(report, doc['path'], root,
                                    doc.get('wire_text', doc['text']).replace('\r\n', '\n').replace('\r', '\n'), process.returncode,
                                    selected_paths=paths), snapshots[uri][1]) for uri, doc in documents.items()}


MAX_WORKSPACE_BYTES = 128 * 1024 * 1024
MAX_WORKSPACE_ENTRIES = 20000


def file_stamp(info):
    return (info.st_dev, info.st_ino, info.st_mode, info.st_size,
            info.st_mtime_ns, info.st_ctime_ns)


class BufferWorkspace:
    """Private complete workspace copy with exact editor buffers substituted.

    This is an input snapshot, NOT an execution sandbox. The explicit trusted
    scanner still owns detector, ignore and tool policy. No hard links, symlinks,
    Git redirections or unbounded context copies are permitted. Retained metadata
    lets publication verify the disk context after this temporary tree is gone.
    """
    def __init__(self, root, root_id, documents, cancel, deadline, *, cache=None):
        self.original, self.root_id = root, root_id
        self.documents, self.cancel, self.deadline = documents, cancel, deadline
        self.entries = {}
        self.missing = set()
        self.temporary = None
        self.root = None
        self.cache = cache
        self.content_hashes = {}
        self.shadow_stamps = {}
        self.buffer_hashes = {}
        self.expected_paths = set()
        self.reused = False
        self.copied_bytes = 0
        self.buffer_bytes_written = 0

    def check(self):
        if self.cancel.is_set():
            raise ProtocolError('Buffer scan cancelled')
        if time.monotonic() >= self.deadline:
            raise ProtocolError('Buffer snapshot/scan timed out')

    def open_original(self, relative, *, final_flags=os.O_RDONLY):
        self.check()
        flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
        descriptor = os.open(self.original, flags)
        try:
            info = os.fstat(descriptor)
            if (info.st_dev, info.st_ino) != self.root_id:
                raise ProtocolError('Repository root was replaced')
            parts = relative.parts
            for index, part in enumerate(parts):
                self.check()
                if part in ('', '.', '..'):
                    raise ProtocolError('Unsafe buffer workspace path')
                mode = flags if index < len(parts) - 1 else final_flags | os.O_NONBLOCK | os.O_NOFOLLOW
                child = os.open(part, mode, dir_fd=descriptor)
                os.close(descriptor)
                descriptor = child
            result, descriptor = descriptor, None
            return result
        finally:
            if descriptor is not None:
                os.close(descriptor)

    def verify(self):
        """Validate every original entry, including dirs and absent new buffers."""
        for relative, expected in self.entries.items():
            fd = self.open_original(relative)
            try:
                if file_stamp(os.fstat(fd)) != expected:
                    raise ProtocolError('Workspace context changed during buffer analysis: ' + str(relative))
            finally:
                os.close(fd)
        for relative in self.missing:
            try:
                fd = self.open_original(relative)
            except FileNotFoundError:
                continue
            else:
                os.close(fd)
                raise ProtocolError('A new buffer acquired disk contents during analysis: ' + str(relative))
        if self.shadow_stamps:
            self.verify_shadow()

    def validate_configuration(self):
        self.check()
        if any(key.startswith('GIT_') for key in os.environ):
            raise ProtocolError('Buffer snapshots do not support redirected Git environments')
        if any((parent / '.git').exists() for parent in self.original.parents):
            raise ProtocolError('Buffer mode requires the complete repository root, not an inherited Git subdirectory')
        # Refuse an in-repository temp location BEFORE creating anything there.
        temp_parent = Path(tempfile.gettempdir()).resolve()
        if temp_parent.is_relative_to(self.original):
            raise ProtocolError('Buffer snapshot temporary directory must be outside --repo')
        return temp_parent

    def __enter__(self):
        if self.cache is not None:
            return self.cache.enter(self)
        return self.build()

    def build(self):
        temp_parent = self.validate_configuration()
        self.temporary = tempfile.TemporaryDirectory(prefix='ubs-lsp-buffer-', dir=temp_parent)
        try:
            self.root = Path(self.temporary.name) / 'workspace'
            self.root.mkdir(mode=0o700)
            pending = [Path('.')]
            total = 0
            while pending:
                self.check()
                relative = pending.pop()
                if len(self.entries) >= MAX_WORKSPACE_ENTRIES:
                    raise ProtocolError('Buffer workspace entry limit exceeded')
                fd = self.open_original(relative)
                try:
                    info = os.fstat(fd)
                    stamp = file_stamp(info)
                    self.entries[relative] = stamp
                    target = self.root / relative
                    if stat.S_ISDIR(info.st_mode):
                        target.mkdir(mode=0o700, exist_ok=True)
                        children = []
                        with os.scandir(fd) as items:
                            for item in items:
                                self.check()
                                if len(self.entries) + len(pending) + len(children) >= MAX_WORKSPACE_ENTRIES:
                                    raise ProtocolError('Buffer workspace entry limit exceeded')
                                children.append(item.name)
                        pending.extend(relative / name for name in sorted(children, reverse=True))
                    elif stat.S_ISREG(info.st_mode):
                        if relative.name == '.git' or ('.git' in relative.parts and relative.name in {'commondir', 'gitdir', 'alternates'}):
                            raise ProtocolError('External/linked Git metadata is not supported in buffer snapshots')
                        if info.st_size > MAX_WORKSPACE_BYTES - total:
                            raise ProtocolError('Buffer workspace byte limit exceeded')
                        git_config = '.git' in relative.parts and relative.name in {'config', 'config.worktree'}
                        tail = b''
                        digest = hashlib.sha256()
                        with target.open('xb') as output:
                            while chunk := os.read(fd, min(65536, MAX_WORKSPACE_BYTES - total + 1)):
                                self.check()
                                total += len(chunk)
                                if total > MAX_WORKSPACE_BYTES:
                                    raise ProtocolError('Buffer workspace byte limit exceeded')
                                if git_config:
                                    tokens = (tail + chunk).lower()
                                    if any(token in tokens for token in (b'include', b'worktree', b'excludesfile')):
                                        raise ProtocolError('Path-dependent Git configuration is not supported in buffer snapshots')
                                    tail = tokens[-32:]
                                output.write(chunk)
                                digest.update(chunk)
                                self.copied_bytes += len(chunk)
                        target.chmod(0o700 if info.st_mode & 0o111 else 0o600)
                        if self.cache is not None:
                            self.content_hashes[relative] = digest.digest()
                    else:
                        raise ProtocolError('Buffer context must contain only regular files and directories: ' + str(relative))
                    if file_stamp(os.fstat(fd)) != stamp:
                        raise ProtocolError('Workspace input changed while snapshotting: ' + str(relative))
                finally:
                    os.close(fd)
            paths = set()
            virtual_paths = set(self.entries)
            for doc in self.documents.values():
                self.check()
                path = doc['path']
                relative = path.relative_to(self.original)
                if not relative.parts or '..' in relative.parts or '.git' in relative.parts or relative in paths:
                    raise ProtocolError('Unsafe, duplicate or Git-metadata buffer path')
                if len(relative.parts) > 128:
                    raise ProtocolError('Buffer path nesting limit exceeded')
                paths.add(relative)
                additions = {relative, *relative.parents} - virtual_paths
                if len(virtual_paths) + len(additions) > MAX_WORKSPACE_ENTRIES:
                    raise ProtocolError('Buffer workspace entry limit exceeded')
                virtual_paths.update(additions)
                if relative in self.entries:
                    if not stat.S_ISREG(self.entries[relative][2]):
                        raise ProtocolError('An editor buffer cannot replace a directory')
                    old_size = self.entries[relative][3]
                else:
                    # A missing leaf/parent is valid for a new unsaved file.
                    # Non-directory or symlink parents still fail closed.
                    try:
                        fd = self.open_original(relative)
                    except FileNotFoundError:
                        self.missing.add(relative)
                    else:
                        os.close(fd)
                        raise ProtocolError('New buffer appeared while creating snapshot')
                    old_size = 0
                raw = editor_text(doc.get('wire_text', doc['text'])).encode('utf-8')
                total += len(raw) - old_size
                if total > MAX_WORKSPACE_BYTES:
                    raise ProtocolError('Buffer workspace byte limit exceeded')
                target = self.root / relative
                target.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
                # Copied files never share inodes with the checkout.
                with target.open('wb') as output:
                    output.write(raw)
                target.chmod(0o600)
                self.buffer_bytes_written += len(raw)
                if self.cache is not None:
                    self.content_hashes[relative] = hashlib.sha256(raw).digest()
                    self.buffer_hashes[relative] = self.content_hashes[relative]
            self.expected_paths = virtual_paths
            self.verify()
            return self
        except BaseException:
            self.temporary.cleanup()
            raise

    def __exit__(self, exc_type, exc, traceback):
        if self.cache is None:
            self.temporary.cleanup()
        else:
            self.cache.leave(self, exc_type)

    def shadow_guard(self):
        # The root identity is captured before scanner execution, never learned
        # from a potentially replaced root when the next request arrives.
        return BufferWorkspace(self.root, self.shadow_id, {}, self.cancel, self.deadline)

    def seal_shadow(self):
        """Prove the initial private tree contains exactly the copied input.

        This one-time byte check prevents adopting a changed private file as
        the baseline. Later leases check inode/ctime plus the full inventory.
        No finding/result cache is involved.
        """
        info = self.root.lstat()
        self.shadow_id = (info.st_dev, info.st_ino)
        guard = self.shadow_guard()
        pending = [Path('.')]
        stamps = {}
        while pending:
            relative = pending.pop()
            self.check()
            if relative not in self.expected_paths or relative in stamps:
                raise ProtocolError('Unexpected entry in private buffer workspace')
            fd = guard.open_original(relative)
            try:
                before = os.fstat(fd)
                stamps[relative] = file_stamp(before)
                if stat.S_ISDIR(before.st_mode):
                    with os.scandir(fd) as items:
                        for item in items:
                            if len(stamps) + len(pending) >= MAX_WORKSPACE_ENTRIES:
                                raise ProtocolError('Private buffer workspace entry limit exceeded')
                            pending.append(relative / item.name)
                elif stat.S_ISREG(before.st_mode) and before.st_nlink == 1:
                    digest = hashlib.sha256()
                    remaining = before.st_size
                    while chunk := os.read(fd, min(65536, remaining + 1)):
                        self.check()
                        remaining -= len(chunk)
                        if remaining < 0:
                            raise ProtocolError('Private buffer input grew during validation')
                        digest.update(chunk)
                    if remaining or digest.digest() != self.content_hashes.get(relative):
                        raise ProtocolError('Private buffer input differs from copied contents')
                else:
                    raise ProtocolError('Unsafe private buffer workspace entry')
                if file_stamp(os.fstat(fd)) != stamps[relative]:
                    raise ProtocolError('Private buffer input changed during validation')
            finally:
                os.close(fd)
        if set(stamps) != self.expected_paths:
            raise ProtocolError('Private buffer workspace inventory is incomplete')
        self.shadow_stamps = stamps
        self.verify_shadow()

    def verify_shadow(self):
        guard = self.shadow_guard()
        for relative, expected in self.shadow_stamps.items():
            fd = guard.open_original(relative)
            try:
                info = os.fstat(fd)
                if file_stamp(info) != expected or stat.S_ISREG(info.st_mode) and info.st_nlink != 1:
                    raise ProtocolError('Private buffer workspace changed: ' + str(relative))
            finally:
                os.close(fd)

    def rewrite_buffer(self, relative, raw):
        """Write only an authenticated, still-private regular inode."""
        guard = self.shadow_guard()
        fd = guard.open_original(relative, final_flags=os.O_WRONLY)
        try:
            before = os.fstat(fd)
            if (file_stamp(before) != self.shadow_stamps[relative]
                    or not stat.S_ISREG(before.st_mode) or before.st_nlink != 1):
                raise ProtocolError('Private buffer target changed before update')
            os.ftruncate(fd, 0)
            remaining = memoryview(raw)
            while remaining:
                self.check()
                count = os.write(fd, remaining[:65536])
                if count <= 0:
                    raise ProtocolError('Incomplete private buffer write')
                remaining = remaining[count:]
                self.buffer_bytes_written += count
            os.fchmod(fd, 0o600)
            self.shadow_stamps[relative] = file_stamp(os.fstat(fd))
            self.content_hashes[relative] = hashlib.sha256(raw).digest()
            self.buffer_hashes[relative] = self.content_hashes[relative]
        finally:
            os.close(fd)

    def refresh_original(self):
        """Refresh changed regular support files without recopying stable inputs.

        Enumerate the complete original graph before updating anything. A
        structural change needs a fresh snapshot; metadata changes to existing
        files (including atomic saves) can keep the private graph. Selected
        buffer text always wins over newer saved bytes. All guards are local
        to this generation, and any mid-refresh race discards the whole lease.
        """
        current = {}
        pending = [Path('.')]
        original_bytes = 0
        while pending:
            relative = pending.pop()
            self.check()
            if len(current) >= MAX_WORKSPACE_ENTRIES:
                raise ProtocolError('Buffer workspace entry limit exceeded')
            fd = self.open_original(relative)
            try:
                info = os.fstat(fd)
                stamp = file_stamp(info)
                current[relative] = stamp
                if stat.S_ISDIR(info.st_mode):
                    children = []
                    with os.scandir(fd) as items:
                        for item in items:
                            self.check()
                            if len(current) + len(pending) + len(children) >= MAX_WORKSPACE_ENTRIES:
                                raise ProtocolError('Buffer workspace entry limit exceeded')
                            children.append(item.name)
                    pending.extend(relative / name for name in sorted(children, reverse=True))
                elif stat.S_ISREG(info.st_mode):
                    original_bytes += info.st_size
                    if original_bytes > MAX_WORKSPACE_BYTES:
                        raise ProtocolError('Buffer workspace byte limit exceeded')
                else:
                    raise ProtocolError('Unsafe original workspace entry: ' + str(relative))
                if file_stamp(os.fstat(fd)) != stamp:
                    raise ProtocolError('Workspace changed during incremental enumeration')
            finally:
                os.close(fd)
        if (current.keys() != self.entries.keys()
                or any(stat.S_IFMT(stamp[2]) != stat.S_IFMT(self.entries[path][2])
                       for path, stamp in current.items())):
            return False
        if len(self.expected_paths) > MAX_WORKSPACE_ENTRIES:
            raise ProtocolError('Buffer workspace entry limit exceeded')
        updates = [path for path, stamp in current.items()
                   if stat.S_ISREG(stamp[2]) and path not in self.buffer_hashes
                   and stamp != self.entries[path]]
        total = sum(stamp[3] for stamp in self.shadow_stamps.values() if stat.S_ISREG(stamp[2]))
        total += sum(current[path][3] - self.shadow_stamps[path][3] for path in updates)
        if total > MAX_WORKSPACE_BYTES:
            raise ProtocolError('Buffer workspace byte limit exceeded')
        self.entries = current
        self.verify()
        for relative in updates:
            self.refresh_support_file(relative)
        self.verify()
        return True

    def refresh_support_file(self, relative):
        """Stream a changed source into its authenticated private counterpart."""
        expected = self.entries[relative]
        source = self.open_original(relative)
        try:
            if file_stamp(os.fstat(source)) != expected:
                raise ProtocolError('Workspace context changed before incremental copy')
            guard = self.shadow_guard()
            target = guard.open_original(relative, final_flags=os.O_WRONLY)
            try:
                info = os.fstat(target)
                if (file_stamp(info) != self.shadow_stamps[relative]
                        or not stat.S_ISREG(info.st_mode) or info.st_nlink != 1):
                    raise ProtocolError('Private support target changed before update')
                os.ftruncate(target, 0)
                remaining = expected[3]
                digest = hashlib.sha256()
                tail = b''
                git_config = '.git' in relative.parts and relative.name in {'config', 'config.worktree'}
                while chunk := os.read(source, min(65536, remaining + 1)):
                    self.check()
                    remaining -= len(chunk)
                    if remaining < 0:
                        raise ProtocolError('Workspace context grew during incremental copy')
                    if git_config:
                        tokens = (tail + chunk).lower()
                        if any(token in tokens for token in (b'include', b'worktree', b'excludesfile')):
                            raise ProtocolError('Path-dependent Git configuration is not supported in buffer snapshots')
                        tail = tokens[-32:]
                    digest.update(chunk)
                    output = memoryview(chunk)
                    while output:
                        self.check()
                        count = os.write(target, output[:65536])
                        if count <= 0:
                            raise ProtocolError('Incomplete private support write')
                        output = output[count:]
                        self.copied_bytes += count
                if remaining or file_stamp(os.fstat(source)) != expected:
                    raise ProtocolError('Workspace context changed during incremental copy')
                os.fchmod(target, 0o700 if expected[2] & 0o111 else 0o600)
                self.shadow_stamps[relative] = file_stamp(os.fstat(target))
                self.content_hashes[relative] = digest.digest()
            finally:
                os.close(target)
        finally:
            os.close(source)


class BufferWorkspaceCache:
    """One private workspace, exclusively leased to one scanner at a time.

    Only an unchanged graph and the same selected paths may be reused. Changed
    regular-file contents are refreshed under the complete inventory guards.
    Every generation has its own immutable source guard; a stale result never
    borrows the metadata, cancellation token or deadline of a newer lease.
    """
    def __init__(self):
        self.retained = None
        self.lock = threading.Lock()
        self.closed = False

    def discard(self):
        previous, self.retained = self.retained, None
        if previous is not None:
            previous.temporary.cleanup()

    def enter(self, workspace):
        if not self.lock.acquire(blocking=False):
            raise ProtocolError('Private buffer workspace is already in use')
        try:
            if self.closed:
                raise ProtocolError('Private buffer workspace cache is closed')
            workspace.validate_configuration()
            previous = self.retained
            selected = {doc['path'] for doc in workspace.documents.values()}
            same_scope = (previous is not None and workspace.original == previous.original
                          and workspace.root_id == previous.root_id
                          and selected == {doc['path'] for doc in previous.documents.values()}
                          and len(selected) == len(workspace.documents))
            if same_scope:
                workspace.root, workspace.temporary = previous.root, previous.temporary
                workspace.entries = dict(previous.entries)
                workspace.missing = set(previous.missing)
                workspace.expected_paths = set(previous.expected_paths)
                workspace.content_hashes = dict(previous.content_hashes)
                workspace.buffer_hashes = dict(previous.buffer_hashes)
                workspace.shadow_stamps = dict(previous.shadow_stamps)
                workspace.shadow_id = previous.shadow_id
                try:
                    workspace.verify_shadow()
                except (OSError, ProtocolError):
                    workspace.check()  # Cancellation/timeouts do not authorize a retry.
                    same_scope = False
                if same_scope:
                    same_scope = workspace.refresh_original()
            if same_scope:
                total = sum(stamp[3] for stamp in workspace.shadow_stamps.values() if stat.S_ISREG(stamp[2]))
                original_total = sum(stamp[3] for stamp in workspace.entries.values() if stat.S_ISREG(stamp[2]))
                if (len(workspace.expected_paths) > MAX_WORKSPACE_ENTRIES
                        or max(total, original_total) > MAX_WORKSPACE_BYTES):
                    raise ProtocolError('Retained buffer workspace exceeds current bounds')
                updates = []
                for doc in workspace.documents.values():
                    workspace.check()
                    relative = doc['path'].relative_to(workspace.original)
                    raw = editor_text(doc.get('wire_text', doc['text'])).encode('utf-8')
                    total += len(raw) - workspace.shadow_stamps[relative][3]
                    updates.append((relative, raw))
                if total > MAX_WORKSPACE_BYTES:
                    raise ProtocolError('Buffer workspace byte limit exceeded')
                for relative, raw in updates:
                    if hashlib.sha256(raw).digest() != workspace.buffer_hashes[relative]:
                        workspace.rewrite_buffer(relative, raw)
                workspace.reused = True
                workspace.verify()
                self.retained = None  # Ownership passes to this exclusive lease.
                return workspace
            self.discard()
            # Do not retain any old inventory if an authoritative rebuild is needed.
            workspace.root = workspace.temporary = None
            workspace.entries.clear()
            workspace.missing.clear()
            workspace.shadow_stamps.clear()
            workspace.content_hashes.clear()
            workspace.buffer_hashes.clear()
            workspace.build()
            workspace.seal_shadow()
            return workspace
        except BaseException:
            try:
                self.discard()
            finally:
                try:
                    if workspace.temporary is not None:
                        workspace.temporary.cleanup()
                finally:
                    self.lock.release()
            raise

    def leave(self, workspace, exc_type):
        try:
            if exc_type is None:
                workspace.verify()
                self.retained = workspace
            else:
                workspace.temporary.cleanup()
        except BaseException:
            workspace.temporary.cleanup()
            raise
        finally:
            self.lock.release()

    def close(self):
        # Server.close joins scanner workers first. Reject misuse rather than
        # deleting input still in use by a live scanner.
        if not self.lock.acquire(blocking=False):
            raise ProtocolError('Cannot close an active private buffer workspace')
        try:
            self.closed = True
            self.discard()
        finally:
            self.lock.release()

    def clear(self):
        """Drop idle plaintext copies while allowing a later document reopen."""
        if not self.lock.acquire(blocking=False):
            raise ProtocolError('Cannot clear an active private buffer workspace')
        try:
            self.discard()
        finally:
            self.lock.release()


def scan_buffers(scanner, root, documents, root_id, timeout, cancel, policy=(), *, cache=None):
    if any(not doc['synchronized'] for doc in documents.values()):
        return {uri: ([note('ubs.unverified', 'Synchronize every selected buffer before analysis.', 3)], None)
                for uri in documents}
    with BufferWorkspace(root, root_id, documents, cancel, time.monotonic() + timeout, cache=cache) as workspace:
        selected = {uri: dict(doc, path=workspace.root / doc['path'].relative_to(root))
                    for uri, doc in documents.items()}
        info = workspace.root.stat()
        workspace.check()
        results = scan(scanner, workspace.root, selected, (info.st_dev, info.st_ino),
                       workspace.deadline - time.monotonic(), cancel, policy)
        workspace.verify()
        # Diagnostics route against the shadow paths, but no private temporary
        # path should escape into messages. Publication uses the original URIs.
        for diagnostics, _ in results.values():
            for diagnostic in diagnostics:
                diagnostic['message'] = diagnostic['message'].replace(str(workspace.root), str(root))
                diagnostic['data'] = {'ubsSourceMode': 'buffer'}
        return {uri: (value[0], workspace) for uri, value in results.items()}


class Server:
    def __init__(self, root, scanner, send, *, jobs=2, timeout=120, policy=(), buffer_mode=False,
                 incremental_workspace=False):
        self.root, self.scanner, self.send = root, scanner, send
        info = root.stat()
        self.root_id = (info.st_dev, info.st_ino)
        self.jobs, self.timeout = jobs, timeout
        self.policy = policy
        self.buffer_mode = buffer_mode
        if incremental_workspace and not buffer_mode:
            raise ProtocolError('Incremental workspaces require buffer mode')
        self.workspace_cache = BufferWorkspaceCache() if incremental_workspace else None
        self.pool = ThreadPoolExecutor(max_workers=jobs, thread_name_prefix='ubs-lsp')
        self.documents = {}
        self.pending = OrderedDict()
        self.active = {}
        self.generation = 0
        self.initialized = False
        self.shutdown = False
        self.exit_code = None
        self.batch_pending = None
        self.batch_due = 0
        self.batch = None
        self.published_group = set()
        self.register_watches = False
        self.registration_pending = False

    def cancel_batch(self, *, announce=True):
        selected = set(self.batch_pending or (self.batch[1] if self.batch and not self.batch[2].is_set() else {})) | self.published_group
        self.published_group = set()
        self.batch_pending = None
        if self.batch:
            self.batch[2].set()
        for uri in selected if announce else ():
            if uri in self.documents:
                message = ('Buffer snapshot invalidated; updated buffer analysis is pending.' if self.buffer_mode else
                           'Selected-document scan invalidated; rescan after saving all documents.')
                self.publish(uri, [note('ubs.unverified', message, 3)])

    def publish(self, uri, diagnostics):
        params = {'uri': uri, 'diagnostics': diagnostics}
        if uri in self.documents:
            doc = self.documents[uri]
            params['version'] = doc['version'] if doc['synchronized'] else doc.get('sync_version', doc['version'])
        self.send({'jsonrpc': '2.0', 'method': 'textDocument/publishDiagnostics', 'params': params})

    def invalidate(self, uri):
        # Any document/scope change makes a grouped result obsolete, including
        # changes to a different file on which a clean result may depend.
        if self.batch_pending is not None or self.batch is not None or self.published_group:
            self.cancel_batch()
        self.generation += 1
        self.pending.pop(uri, None)
        for _, (target, _, cancel) in self.active.items():
            if target == uri:
                cancel.set()
        if uri in self.documents:
            self.documents[uri]['generation'] = self.generation

    def queue(self, uri):
        if self.buffer_mode:
            self.queue_documents()
            return
        self.invalidate(uri)
        self.pending[uri] = self.documents[uri]['generation']
        self.publish(uri, [note('ubs.pending', 'UBS verification pending for this saved document.', 3)])

    def queue_documents(self):
        self.cancel_batch()
        for uri in self.documents:
            self.invalidate(uri)
        self.pending.clear()
        self.batch_pending = {uri: dict(doc) for uri, doc in self.documents.items()} or None
        self.batch_due = time.monotonic() + 0.15
        for uri in self.documents:
            self.publish(uri, [note('ubs.pending', 'UBS selected-document verification pending.', 3)])

    def complete(self, future, documents, cancel):
        if self.shutdown or cancel.is_set() or any(uri not in self.documents or self.documents[uri]['generation'] != doc['generation']
                                                  for uri, doc in documents.items()):
            return
        try:
            result = future.result()
            # Verify the complete group before publishing ANY member, not a
            # sequence of individually eligible clean results from mixed bytes.
            verified = set()
            for uri, doc in documents.items():
                identity = result[uri][1]
                if isinstance(identity, BufferWorkspace):
                    if identity not in verified:
                        identity.verify()
                        verified.add(identity)
                    continue
                if identity is not None and read_source(self.root, doc['path'], self.root_id) != (doc['text'], identity):
                    raise ProtocolError('Selected source changed before diagnostics could be published')
        except Exception as exc:
            result = {uri: ([note('ubs.unverified', 'UBS could not verify this document: ' + str(exc))], None) for uri in documents}
        for uri in documents:
            self.publish(uri, result[uri][0])
        return True

    def tick(self):
        for future, (uri, generation, cancel) in list(self.active.items()):
            if not future.done():
                continue
            del self.active[future]
            doc = self.documents.get(uri)
            if self.shutdown or doc is None or doc['generation'] != generation or cancel.is_set():
                continue
            self.complete(future, {uri: doc}, cancel)
        if self.batch and self.batch[0].done():
            future, documents, cancel = self.batch
            self.batch = None
            if self.complete(future, documents, cancel):
                self.published_group = set(documents)
        if self.workspace_cache is not None and not self.active and self.batch is None and (self.shutdown or not self.documents):
            self.workspace_cache.clear()
        if self.batch_pending is not None and not self.active and self.batch is None and time.monotonic() >= self.batch_due:
            documents, self.batch_pending = self.batch_pending, None
            cancel = threading.Event()
            options = {'cache': self.workspace_cache} if self.workspace_cache is not None else {}
            self.batch = (self.pool.submit(scan_buffers if self.buffer_mode else scan, self.scanner, self.root, documents, self.root_id,
                                           self.timeout, cancel, self.policy, **options), documents, cancel)
        busy = {uri for uri, _, _ in self.active.values()}
        for uri, generation in list(self.pending.items()):
            if self.shutdown or self.batch or self.batch_pending is not None or len(self.active) >= self.jobs:
                break
            if uri in busy:
                continue
            del self.pending[uri]
            doc = self.documents[uri]
            cancel = threading.Event()
            future = self.pool.submit(scan, self.scanner, self.root, {uri: dict(doc)}, self.root_id, self.timeout, cancel, self.policy)
            self.active[future] = (uri, generation, cancel)

    def handle(self, message):
        if (isinstance(message, dict) and message.get('jsonrpc') == '2.0' and 'method' not in message
                and message.get('id') == 'ubs-watch-registration' and self.registration_pending):
            self.registration_pending = False
            if 'error' in message:
                self.send({'jsonrpc': '2.0', 'method': 'window/logMessage', 'params': {
                    'type': 2, 'message': 'Editor file-watch registration failed; use ubs.scanOpenDocuments to refresh dependency changes.'}})
            return
        request_id = message.get('id') if isinstance(message, dict) else None
        is_request = isinstance(message, dict) and 'id' in message
        if (not isinstance(message, dict) or message.get('jsonrpc') != '2.0'
                or not isinstance(message.get('method'), str)
                or is_request and type(request_id) not in (str, int)):
            self.send({'jsonrpc': '2.0', 'id': request_id if type(request_id) in (str, int) else None,
                       'error': {'code': -32600, 'message': 'Invalid JSON-RPC request'}})
            return
        try:
            if not isinstance(message, dict) or message.get('jsonrpc') != '2.0' or not isinstance(message.get('method'), str):
                raise ProtocolError('Invalid JSON-RPC request')
            if is_request and type(request_id) not in (str, int):
                raise ProtocolError('Invalid JSON-RPC id')
            params = message.get('params', {})
            if params is None:
                params = {}
            if not isinstance(params, dict):
                raise ProtocolError('Parameters must be an object')
            method = message['method']
            if method == 'exit':
                self.exit_code = 0 if self.shutdown else 1
                return
            if method == 'initialize' and is_request and not self.initialized:
                uri = params.get('rootUri')
                if uri is not None:
                    if not isinstance(uri, str) or document_path(uri.rstrip('/') + '/.ubs-lsp-root', self.root).parent != self.root:
                        raise ProtocolError('Editor root must match --repo')
                capabilities = params.get('capabilities') or {}
                workspace = capabilities.get('workspace') or {} if isinstance(capabilities, dict) else {}
                watches = workspace.get('didChangeWatchedFiles') or {} if isinstance(workspace, dict) else {}
                self.register_watches = isinstance(watches, dict) and watches.get('dynamicRegistration') is True and watches.get('relativePatternSupport') is True
                self.initialized = True
                self.send({'jsonrpc': '2.0', 'id': request_id, 'result': {
                    'capabilities': {'positionEncoding': 'utf-16',
                                     'experimental': {'ubs': {
                                         'sourceMode': 'buffer' if self.buffer_mode else 'saved',
                                         'workspaceStrategy': 'incremental' if self.workspace_cache is not None else
                                                              'snapshot' if self.buffer_mode else 'original'}},
                                     'executeCommandProvider': {'commands': ['ubs.scanOpenDocuments']}, 'textDocumentSync': {
                        'openClose': True, 'change': 2, 'save': {'includeText': True}}},
                    'serverInfo': {'name': 'ubs-lsp', 'version': '1'}}})
                return
            if not self.initialized or self.shutdown:
                if is_request:
                    self.send({'jsonrpc': '2.0', 'id': request_id, 'error': {
                        'code': -32002 if not self.initialized else -32600, 'message': 'Server is not running'}})
                return
            if method == 'shutdown' and is_request:
                self.shutdown = True
                self.cancel_batch(announce=False)
                self.pending.clear()
                for _, _, cancel in self.active.values():
                    cancel.set()
                self.send({'jsonrpc': '2.0', 'id': request_id, 'result': None})
                return
            if method == 'workspace/executeCommand' and is_request:
                if params.get('command') != 'ubs.scanOpenDocuments' or params.get('arguments', []) != []:
                    raise ProtocolError('Only ubs.scanOpenDocuments without arguments is supported')
                self.queue_documents()
                self.send({'jsonrpc': '2.0', 'id': request_id, 'result': {'queued': len(self.documents)}})
                return
            if is_request:
                self.send({'jsonrpc': '2.0', 'id': request_id, 'error': {'code': -32601, 'message': 'Method not found'}})
                return
            if method == 'initialized' and self.register_watches:
                self.register_watches = False
                self.registration_pending = True
                self.send({'jsonrpc': '2.0', 'id': 'ubs-watch-registration', 'method': 'client/registerCapability',
                           'params': {'registrations': [{'id': 'ubs-project-inputs', 'method': 'workspace/didChangeWatchedFiles',
                                      'registerOptions': {'watchers': [{'globPattern': {'baseUri': self.root.as_uri(), 'pattern': '**/*'}, 'kind': 7}]}}]}})
                return
            if method == 'workspace/didChangeWatchedFiles':
                changes = params.get('changes')
                if not isinstance(changes, list) or len(changes) > 4096:
                    raise ProtocolError('Invalid or oversized watched-file notification')
                for change in changes:
                    if not isinstance(change, dict) or type(change.get('type')) is not int or change['type'] not in (1, 2, 3):
                        raise ProtocolError('Invalid watched-file event')
                    document_path(change.get('uri'), self.root)
                if changes:
                    self.queue_documents()
                return
            if method in ('initialized', '$/cancelRequest', '$/setTrace'):
                return
            if method not in ('textDocument/didOpen', 'textDocument/didChange', 'textDocument/didSave', 'textDocument/didClose'):
                return
            item = params.get('textDocument')
            if not isinstance(item, dict):
                raise ProtocolError('Missing textDocument')
            uri = item.get('uri')
            path = document_path(uri, self.root)
            if method == 'textDocument/didClose':
                self.invalidate(uri)
                self.documents.pop(uri, None)
                self.publish(uri, [])
                if self.buffer_mode:
                    self.queue_documents()
                return
            if method == 'textDocument/didOpen':
                if uri in self.documents or len(self.documents) >= MAX_DOCUMENTS:
                    raise ProtocolError('Duplicate document or too many open documents')
                wire_text, version = editor_text(item.get('text')), item.get('version')
            elif method == 'textDocument/didChange':
                if uri not in self.documents:
                    raise ProtocolError('Document is not open')
                version = item.get('version')
                if type(version) is not int or version <= self.documents[uri].get('sync_version', self.documents[uri]['version']):
                    raise ProtocolError('Document version must increase')
                changes = params.get('contentChanges')
                doc = self.documents[uri]
                wire_text = apply_changes(doc.get('wire_text', doc['text']), changes,
                                          synchronized=doc['synchronized'])
            else:
                if uri not in self.documents:
                    raise ProtocolError('Document is not open')
                if not self.documents[uri]['synchronized']:
                    raise ProtocolError('A full document change is required after a synchronization error')
                if 'text' in params and normalized_text(params['text']) != self.documents[uri]['text']:
                    raise ProtocolError('Save text disagrees with the synchronized editor document')
                self.queue(uri)
                return
            if type(version) is not int:
                raise ProtocolError('Document version must be an integer')
            text = normalized_text(wire_text)
            total = sum(len(doc.get('wire_text', doc['text']).encode('utf-8'))
                        for key, doc in self.documents.items() if key != uri)
            if total + len(wire_text.encode('utf-8')) > MAX_TEXT_TOTAL:
                raise ProtocolError('Open document memory limit reached')
            self.invalidate(uri)
            self.documents[uri] = {'path': path, 'text': text, 'wire_text': wire_text,
                                   'version': version, 'sync_version': version, 'generation': self.generation,
                                   'synchronized': True}
            if method == 'textDocument/didOpen' or self.buffer_mode:
                self.queue(uri)
            else:
                self.publish(uri, [note('ubs.unsaved', 'Save this document to run UBS; unsaved buffers are not scanned.', 3)])
        except (ValueError, OSError, TypeError, RecursionError) as exc:
            if is_request:
                self.send({'jsonrpc': '2.0', 'id': request_id if type(request_id) in (str, int) else None,
                           'error': {'code': -32602, 'message': str(exc)}})
            else:
                # Bad document notifications must invalidate outstanding work,
                # not let an older generation appear current after a parse error.
                params = message.get('params', {}) if isinstance(message, dict) else {}
                item = params.get('textDocument', {}) if isinstance(params, dict) else {}
                uri = item.get('uri') if isinstance(item, dict) else None
                if isinstance(uri, str) and uri in self.documents:
                    self.invalidate(uri)
                    self.documents[uri]['synchronized'] = False
                    # A rejected higher-version delta still advances the wire
                    # high-water mark; older full replacements cannot revive it.
                    version = item.get('version')
                    if type(version) is int:
                        doc = self.documents[uri]
                        doc['sync_version'] = max(version, doc.get('sync_version', doc['version']))
                    self.publish(uri, [note('ubs.unverified', str(exc))])
                self.send({'jsonrpc': '2.0', 'method': 'window/logMessage', 'params': {'type': 1, 'message': str(exc)}})

    def close(self):
        self.cancel_batch(announce=False)
        self.pending.clear()
        for _, _, cancel in self.active.values():
            cancel.set()
        self.pool.shutdown(wait=True, cancel_futures=True)
        if self.workspace_cache is not None:
            self.workspace_cache.close()


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--repo', required=True, help='trusted workspace root; editor cannot broaden it')
    parser.add_argument('--scanner', default=str(Path(__file__).resolve().with_name('ubs')))
    parser.add_argument('--jobs', type=int, default=2)
    parser.add_argument('--scan-timeout', type=float, default=120)
    parser.add_argument('--profile', choices=('strict', 'loose'))
    parser.add_argument('--fail-on-warning', action='store_true')
    parser.add_argument('--buffer-mode', choices=('saved', 'snapshot', 'incremental'), default='saved',
                        help='saved (default), one-shot snapshot, or reusable incremental private buffer workspace')
    args = parser.parse_args(argv)
    if os.name != 'posix' or not 1 <= args.jobs <= 4 or not 0 < args.scan_timeout <= 3600:
        parser.error('POSIX, 1–4 jobs and a finite timeout of 0–3600 seconds are required')
    root = Path(args.repo).resolve(strict=True)
    scanner = Path(args.scanner).resolve(strict=True)
    if not root.is_dir() or not scanner.is_file() or not os.access(scanner, os.X_OK):
        parser.error('Repository must be a directory and scanner must be executable')
    outgoing = deque()
    output_bytes = 0
    def send(message):
        nonlocal output_bytes
        data = frame(message)
        if output_bytes + len(data) > 2 * MAX_MESSAGE:
            raise ProtocolError('Editor is not consuming diagnostics; output limit exceeded')
        outgoing.append(memoryview(data))
        output_bytes += len(data)
    policy = (('--profile=' + args.profile,) if args.profile else ()) + (('--fail-on-warning',) if args.fail_on_warning else ())
    server = Server(root, scanner, send, jobs=args.jobs, timeout=args.scan_timeout, policy=policy,
                    buffer_mode=args.buffer_mode != 'saved', incremental_workspace=args.buffer_mode == 'incremental')
    framer = Framer()
    incoming, output = sys.stdin.fileno(), sys.stdout.fileno()
    old_in, old_out = os.get_blocking(incoming), os.get_blocking(output)
    os.set_blocking(incoming, False)
    os.set_blocking(output, False)
    def stop(_signal, _frame):
        raise KeyboardInterrupt
    previous = signal.signal(signal.SIGTERM, stop)
    try:
        with selectors.SelectSelector() as selector:
            selector.register(incoming, selectors.EVENT_READ)
            writing = False
            while server.exit_code is None:
                server.tick()
                if outgoing and not writing:
                    selector.register(output, selectors.EVENT_WRITE)
                    writing = True
                elif not outgoing and writing:
                    selector.unregister(output)
                    writing = False
                for key, _ in selector.select(0.03):
                    if key.fd == incoming:
                        data = os.read(incoming, 65536)
                        if not data:
                            if framer.buffer or framer.expected is not None:
                                raise ProtocolError('Incomplete LSP frame at EOF')
                            return 0 if server.shutdown else 1
                        for message in framer.feed(data):
                            server.handle(message)
                            if server.exit_code is not None:
                                break
                    elif outgoing:
                        try:
                            sent = os.write(output, outgoing[0][:65536])
                        except BlockingIOError:
                            continue
                        output_bytes -= sent
                        outgoing[0] = outgoing[0][sent:]
                        if not outgoing[0]:
                            outgoing.popleft()
            return server.exit_code
    finally:
        server.close()
        signal.signal(signal.SIGTERM, previous)
        os.set_blocking(incoming, old_in)
        os.set_blocking(output, old_out)


if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        raise SystemExit(130)
    except (OSError, ValueError) as exc:
        print(f'ubs-lsp: {exc}', file=sys.stderr)
        raise SystemExit(2)
